          <mxGeometry height="90" width="270" x="1130" y="55" as="geometry" />
        </mxCell>
        <mxCell id="p1-nudge-action" parent="p1-out-lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6A033;fontSize=14;spacing=8;" value="&lt;b&gt;เก็บเงินไว้ก่อน&lt;/b&gt; หรือ&lt;br&gt;&lt;b&gt;ยังต้องการใช้เงิน&lt;/b&gt;&lt;br&gt;ไม่สร้าง Pending Instruction" vertex="1">
          <mxGeometry height="90" width="270" x="1130" y="165" as="geometry" />
