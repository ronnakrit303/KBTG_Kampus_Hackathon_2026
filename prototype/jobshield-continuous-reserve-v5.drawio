  <diagram id="v5-build" name="02 Build Reserve">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2-title" value="K PLUS JobShield — Build Reserve" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#174C3C;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p2-sub" value="เงินสำรองตั้งหลักก้อนเดียว: เริ่มจากเงินที่มีอยู่ และเปิด Auto-Routing เมื่อพร้อม" style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#49645C;align=left;" vertex="1" parent="1">
