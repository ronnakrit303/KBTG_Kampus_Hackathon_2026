  <diagram id="v5-lifecycle" name="01 End-to-End Lifecycle">
    <mxGraphModel dx="890" dy="495" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#174C3C;align=left;verticalAlign=middle;" value="K PLUS JobShield — เงินสำรองตั้งหลักก้อนเดียว" vertex="1">
          <mxGeometry height="45" width="1100" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="p1-sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#49645C;align=left;verticalAlign=middle;" value="สร้างหรือเชื่อม K-ePocket เดียว → ตั้งเป้าหมายและ Auto-Routing → ปกป้องตามความเสี่ยงก่อนเงินออก" vertex="1">
          <mxGeometry height="35" width="1500" x="40" y="65" as="geometry" />
        </mxCell>
        <mxCell id="p1-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8F6;strokeColor=#B7C9C2;fontSize=13;spacing=8;align=left;" value="&lt;b&gt;ขอบเขต V5&lt;/b&gt; • ไม่ถามสถานะงาน • ไม่เปลี่ยนชื่อหรือย้าย Pocket • ไม่อ่านข้อความ/อีเมล • ใช้ deterministic policy และข้อมูลสมมติ" vertex="1">
          <mxGeometry height="55" width="2120" x="40" y="110" as="geometry" />
        </mxCell>
        <mxCell id="p1-setup-lane" parent="1" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#F4FBF8;swimlaneFillColor=#E7F6F0;strokeColor=#49A987;fontSize=15;fontStyle=1;fontColor=#174C3C;horizontal=1;" value="SET UP &amp; BUILD — เงินสำรองตั้งหลักใช้ต่อเนื่องโดยไม่แบ่ง Stage" vertex="1">
          <mxGeometry height="300" width="2120" x="40" y="180" as="geometry" />
        </mxCell>
        <mxCell id="p1-s0" parent="p1-setup-lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;User เปิดใช้งาน JobShield&lt;/b&gt;" vertex="1">
          <mxGeometry height="100" width="230" x="30" y="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-s1" parent="p1-setup-lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;strong&gt;เริ่มตั้งค่าเงินสำรองเอาไว้ตั้งหลัก&lt;/strong&gt;&lt;br&gt;JobShield จะเชื่อมต่อกับ K-ePocket&amp;nbsp;&lt;div&gt;ที่ผู้ใช้มีอยู่แล้ว หรือ หากผู้ใช้ยังไม่มี&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;K-ePocket &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ระบบจะแสดง Pop-up&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ให้ผู้ใช้สร้าง K-ePocket ใหม่ได้ทันที&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ภายในขั้นตอนเดียว&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ซึ่ง&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ผู้ใช้สามารถเลือกได้ระหว่าง:&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;1.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ใช้ Pocket เดิมเป็น &lt;/span&gt;&lt;code dir=&quot;ltr&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;เงินสำรองตั้งหลัก&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code dir=&quot;ltr&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2.&amp;nbsp;สร้าง Pocket ใหม่สำหรับเงินก้อนนี้&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code dir=&quot;ltr&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ซึ่งระบบจะ&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;แนะนำตัวเลือกสร้าง Pocket ใหม่ชื่อ&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;code dir=&quot;ltr&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&quot;เงินสำรองตั้งหลัก&quot; หลังจากนั้้น&amp;nbsp;Pocket จะถูกสร้าง&lt;/code&gt;&lt;/div&gt;&lt;div&gt;&lt;code dir=&quot;ltr&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ต่อเมื่อผู้ใช้กดยืนยัน&lt;/code&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="235" width="340" x="285" y="32.5" as="geometry" />
        </mxCell>
        <mxCell id="p1-s2" parent="p1-setup-lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;กำหนดเป้าหมายของเงินสำรอง&lt;/b&gt;&lt;div&gt;หลังจากสร้าง&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Pocket&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;มาแล้วมันจะมีการให้&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ผู้ใช้ระบุค่าใช้จ่ายจำที่เป็นต่อเดือน&amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;แล้วเลือกว่าต้องการให้เงินสำรองครอบคลุม&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ค่าใช้จ่าย 3 เดือน, 6 เดือน หรือกำหนดเอง&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;เช่น ถ้าเลือก 3 เดือน&amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ค่าใช้จ่ายจำเป็นเดือนละ&amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;15,000 บาท × 3 เดือน&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ดังนั้น&amp;nbsp;เป้าหมายเงินสำรอง = 45,000 บาท&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="215" width="300" x="653" y="42.5" as="geometry" />
        </mxCell>
        <mxCell id="p1-s3" parent="p1-setup-lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A63C7;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;strong&gt;กำหนดยอดเงินเริ่มต้น&lt;/strong&gt;&lt;br&gt;เลือกกันเงินที่มีอยู่ไว้เป็นเงินสำรอง หรือเริ่มต้นที่ 0 บาทก็ได้" vertex="1">
          <mxGeometry height="100" width="235" x="980" y="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-s4" parent="p1-setup-lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#5B93D3;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;ตั้ง Auto-Routing&lt;/b&gt;&lt;br&gt;จำนวนคงที่ หรือ % ของเงินเข้า&lt;br&gt;&lt;font color=&quot;#49645C&quot;&gt;เปิดตอนนี้หรือไว้ภายหลัง&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="260" x="1285" y="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-s5" parent="p1-setup-lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;Review &amp; Consent&lt;/b&gt;&lt;br&gt;Source • Amount/% • Cap&lt;br&gt;Edit / Pause / Off" vertex="1">
          <mxGeometry height="100" width="220" x="1615" y="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-s6" parent="p1-setup-lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2A8F6D;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;Reserve Dashboard&lt;/b&gt;&lt;br&gt;ยอด • เป้าหมาย&lt;br&gt;จำนวนเดือนที่ครอบคลุม" vertex="1">
          <mxGeometry height="100" width="180" x="1900" y="100" as="geometry" />
