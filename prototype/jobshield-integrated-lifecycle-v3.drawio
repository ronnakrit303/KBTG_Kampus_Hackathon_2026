  <diagram id="reserve-builder-v3" name="03 Reserve Builder &amp; Withdrawal">
    <mxGraphModel dx="3200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3200" pageHeight="1400" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="K PLUS JobShield — Reserve Builder &amp; Withdrawal Paths" style="text;html=1;strokeColor=none;fillColor=none;fontSize=30;fontStyle=1;fontColor=#12352B;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1800" height="50" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="ด้านบนสร้างเงินสำรองฉุกเฉิน • ด้านล่างแยกเส้นทางถอนเงิน 3 กรณี โดยไม่ลากเส้นย้อนข้ามกล่อง" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontColor=#49645C;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="82" width="2100" height="35" as="geometry"/></mxCell>
        <mxCell id="build-zone" value="BUILD — สร้างเงินสำรองฉุกเฉินหลังเริ่มมีรายได้" style="swimlane;html=1;rounded=1;startSize=42;fillColor=#EAF3FF;swimlaneFillColor=#F8FBFF;strokeColor=#5B93D3;fontSize=17;fontStyle=1;fontColor=#245B98;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="3100" height="500" as="geometry"/></mxCell>
        <mxCell id="r0" value="&lt;b&gt;เริ่มงาน / กำลังจะได้รับเงินเดือนแรก&lt;/b&gt;&lt;br&gt;Salary event เป็นข้อมูลจำลองหรือวันที่ผู้ใช้กำหนดใน MVP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="280" width="270" height="115" as="geometry"/></mxCell>
        <mxCell id="r1" value="&lt;b&gt;กรอกค่าใช้จ่ายจำเป็นต่อเดือน&lt;/b&gt;&lt;br&gt;เช่น ค่าเช่า อาหาร เดินทาง และภาระจำเป็น" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="420" y="285" width="260" height="105" as="geometry"/></mxCell>
        <mxCell id="r2" value="&lt;b&gt;กำหนดเป้าหมาย&lt;/b&gt;&lt;br&gt;ค่าใช้จ่ายจำเป็น × 3 / 6 เดือน / กำหนดเอง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="740" y="285" width="260" height="105" as="geometry"/></mxCell>
        <mxCell id="r3" value="&lt;b&gt;เปรียบเทียบแผนออม&lt;/b&gt;&lt;br&gt;จำนวนคงที่ หรือ 5% / 10% / 15% / กำหนดเอง&lt;br&gt;แสดงระยะเวลาประมาณการ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1060" y="275" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="r4" value="&lt;b&gt;Review &amp; Consent&lt;/b&gt;&lt;br&gt;ต้นทาง • จำนวน/เปอร์เซ็นต์ • ปลายทาง • เพดาน • รอบถัดไป&lt;br&gt;แก้ไข Pause หรือปิดได้" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A63C7;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1400" y="270" width="290" height="135" as="geometry"/></mxCell>
        <mxCell id="r5" value="&lt;b&gt;Salary Event / Schedule&lt;/b&gt;&lt;br&gt;คำนวณยอดที่ต้องแบ่ง&lt;br&gt;ใช้ idempotency ป้องกันรายการซ้ำ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#5B93D3;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1750" y="280" width="260" height="115" as="geometry"/></mxCell>
        <mxCell id="r6" value="ถึงเพดานแล้ว?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7DA;strokeColor=#E0AA28;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2070" y="280" width="190" height="115" as="geometry"/></mxCell>
        <mxCell id="r7a" value="ยังไม่ถึง&lt;br&gt;แบ่งเงินเข้ากระเป๋า" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2A8F6D;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="2330" y="235" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="r7b" value="ถึงแล้ว&lt;br&gt;หยุด Auto-Routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="2330" y="365" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="r8" value="อัปเดตสถานะ" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2610" y="300" width="120" height="75" as="geometry"/></mxCell>
        <mxCell id="r9" value="&lt;b&gt;Dashboard ความคืบหน้า&lt;/b&gt;&lt;br&gt;ยอด • เป้าหมาย • จำนวนเดือนที่ครอบคลุม • milestone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2A8F6D;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="2800" y="275" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="reward" value="&lt;b&gt;Future Concept&lt;/b&gt;&lt;br&gt;K Point/สิทธิพิเศษจากการเติมเงินหรือถึง milestone&lt;br&gt;ดอกเบี้ยพิเศษยังไม่ระบุอัตราและต้องผ่าน Business/Product approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;dashed=1;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="2800" y="455" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="build-note" value="ให้รางวัลจากการเติมเงินหรือถึง milestone ไม่ลงโทษผู้ใช้ที่ถอนเงินเพื่อเหตุฉุกเฉินจริง • Auto-Routing เป็น opt-in และผู้ใช้ควบคุมได้" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7F6;strokeColor=#B8C8C3;fontSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="505" width="2540" height="65" as="geometry"/></mxCell>
        <mxCell id="withdraw-zone" value="PROTECT — เมื่อต้องการนำเงินสำรองฉุกเฉินออก" style="swimlane;html=1;rounded=1;startSize=42;fillColor=#FFF6DE;swimlaneFillColor=#FFFCF5;strokeColor=#E0AA28;fontSize=17;fontStyle=1;fontColor=#7C5B0D;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="50" y="690" width="3100" height="610" as="geometry"/></mxCell>
        <mxCell id="w0" value="&lt;b&gt;เริ่มจาก Dashboard&lt;/b&gt;&lt;br&gt;เลือก “ต้องการนำเงินออก”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0AA28;strokeWidth=2;dashed=1;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="915" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="w1" value="&lt;b&gt;ระบุรายการ&lt;/b&gt;&lt;br&gt;ยอด • ปลายทาง • วัตถุประสงค์กว้าง&lt;br&gt;แสดงเงินและจำนวนเดือนคงเหลือ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0AA28;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="390" y="900" width="270" height="120" as="geometry"/></mxCell>
        <mxCell id="w2" value="ปลายทางและ&lt;br&gt;บริบทเป็นแบบใด?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0AA28;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730" y="900" width="210" height="120" as="geometry"/></mxCell>
        <mxCell id="wOwn" value="&lt;b&gt;เหตุจำเป็นที่ตรวจสอบได้&lt;/b&gt;&lt;br&gt;บัญชีตนเองหรือ verified biller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F2FF;strokeColor=#5B93D3;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1030" y="755" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="wOwnAction" value="เตือนยอดคงเหลือหนึ่งครั้ง&lt;br&gt;ไม่มี High-Risk delay แบบตายตัว" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1380" y="755" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="wOwnResult" value="ผู้ใช้ยืนยันและใช้เงินได้" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F7EC;strokeColor=#48A66D;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1730" y="760" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="wGeneral" value="&lt;b&gt;ค่าใช้จ่ายทั่วไป&lt;/b&gt;&lt;br&gt;ไม่ใช่ Fraud finding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1030" y="915" width="270" height="85" as="geometry"/></mxCell>
        <mxCell id="wNudge" value="&lt;b&gt;Friendly Character Nudge&lt;/b&gt;&lt;br&gt;“หากใช้ครั้งนี้ เงินสำรองจะเหลือประมาณ X เดือน”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1380" y="905" width="290" height="105" as="geometry"/></mxCell>
        <mxCell id="wChoice" value="ผู้ใช้เลือก" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6A033;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1740" y="910" width="170" height="95" as="geometry"/></mxCell>
        <mxCell id="wKeep" value="เก็บเงินไว้ก่อน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F7EC;strokeColor=#48A66D;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1990" y="870" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="wUse" value="ยังต้องการใช้&lt;br&gt;ยืนยันทำรายการ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6A033;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1990" y="980" width="190" height="75" as="geometry"/></mxCell>
        <mxCell id="wHigh" value="&lt;b&gt;หลายสัญญาณเสี่ยงสูง&lt;/b&gt;&lt;br&gt;ผู้รับใหม่/บัญชีบุคคล + การแบ่งยอด/จ่ายเพื่อเริ่มงาน + destination risk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE5DF;strokeColor=#DD6B55;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1030" y="1085" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="wHighAction" value="&lt;b&gt;ไปหน้า 02 — High-Risk row&lt;/b&gt;&lt;br&gt;Warning → Pending Instruction → Cooling-off → Verify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1EE;strokeColor=#DD6B55;strokeWidth=2;dashed=1;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1380" y="1090" width="310" height="100" as="geometry"/></mxCell>
        <mxCell id="withdraw-note" value="&lt;b&gt;กฎสำคัญ:&lt;/b&gt; การถอนเงินสำรองเพียงอย่างเดียวไม่ถือว่าเป็น Fraud • Pause เฉพาะคำสั่งโอนและยอดที่กำลังเสี่ยง • ไม่ล็อกบัญชีหรือ K-ePocket ทั้งก้อน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A63C7;fontSize=12;spacing=10;align=left;" vertex="1" parent="1"><mxGeometry x="2280" y="865" width="760" height="100" as="geometry"/></mxCell>
        <mxCell id="privacy-note" value="&lt;b&gt;Privacy/Production:&lt;/b&gt; ไม่อ่านข้อความหรืออีเมลโดยอัตโนมัติ • เก็บข้อมูลเท่าที่จำเป็น • ขอ consent ตามวัตถุประสงค์ • ใช้ encryption, key management, access control และ audit ตามมาตรฐานธนาคาร" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7F6;strokeColor=#B8C8C3;fontSize=12;spacing=10;align=left;" vertex="1" parent="1"><mxGeometry x="2280" y="1010" width="760" height="105" as="geometry"/></mxCell>
        <mxCell id="business-note" value="K Point ดอกเบี้ยพิเศษ engagement และ cost saving เป็นสมมติฐาน/Future Concept ที่ต้องผ่านการวิจัยและ Business/Product approval — ไม่แสดงเป็นผลที่พิสูจน์แล้ว" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;dashed=1;fontSize=12;spacing=10;align=left;" vertex="1" parent="1"><mxGeometry x="2280" y="1160" width="760" height="80" as="geometry"/></mxCell>
