<mxfile host="app.diagrams.net" modified="2026-09-06T02:00:00.000Z" agent="Codex" version="24.7.17" type="device" compressed="false" pages="3">
  <diagram id="main-lifecycle-v3" name="01 Main Lifecycle">
    <mxGraphModel dx="3000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="1000" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="K PLUS JobShield — Main Lifecycle" style="text;html=1;strokeColor=none;fillColor=none;fontSize=30;fontStyle=1;fontColor=#12352B;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1600" height="50" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="ภาพรวมเส้นทางหลัก โดยแยกรายละเอียดการป้องกันธุรกรรมและการสร้างเงินสำรองไปยังหน้าถัดไป" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontColor=#49645C;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="82" width="1900" height="35" as="geometry"/></mxCell>
        <mxCell id="legend" value="อ่านจากซ้ายไปขวา • เส้นทุกเส้นอยู่ในช่องว่างระหว่างกล่อง • กล่องขอบประหมายถึงจุดเชื่อมไปยังหน้าอื่น ไม่ใช่การส่งข้อมูลออกนอกระบบ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7F6;strokeColor=#B8C8C3;fontSize=13;fontColor=#36524A;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="50" y="125" width="2900" height="48" as="geometry"/></mxCell>
        <mxCell id="phase-search" value="ช่วงสมัครงาน" style="swimlane;html=1;rounded=1;startSize=42;fillColor=#EAF8F3;swimlaneFillColor=#F8FCFA;strokeColor=#49A987;fontSize=17;fontStyle=1;fontColor=#165E47;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="50" y="200" width="1260" height="500" as="geometry"/></mxCell>
        <mxCell id="phase-transition" value="จุดเปลี่ยนผ่าน" style="swimlane;html=1;rounded=1;startSize=42;fillColor=#FFF6DE;swimlaneFillColor=#FFFCF5;strokeColor=#E0AA28;fontSize=17;fontStyle=1;fontColor=#7C5B0D;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1340" y="200" width="560" height="500" as="geometry"/></mxCell>
        <mxCell id="phase-income" value="หลังเริ่มมีรายได้" style="swimlane;html=1;rounded=1;startSize=42;fillColor=#EAF3FF;swimlaneFillColor=#F8FBFF;strokeColor=#5B93D3;fontSize=17;fontStyle=1;fontColor=#245B98;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1930" y="200" width="1020" height="500" as="geometry"/></mxCell>
        <mxCell id="m0" value="&lt;b&gt;First Jobber กำลังสมัครงาน&lt;/b&gt;&lt;br&gt;เตรียมเงินสำหรับค่าใช้จ่ายระหว่างหางาน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;strokeWidth=2;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="330" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="m1" value="&lt;b&gt;เปิด JobShield / Career Mode&lt;/b&gt;&lt;br&gt;Opt-in • ตั้งวันหมดอายุ • ปิดได้ทุกเมื่อ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2A8F6D;strokeWidth=2;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="390" y="330" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="m2" value="&lt;b&gt;สร้างหรือเชื่อม K-ePocket&lt;/b&gt;&lt;br&gt;ถ้ายังไม่มี เสนอสร้าง 2 กระเป๋าแบบ One-tap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;strokeWidth=2;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="700" y="330" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="m3" value="&lt;b&gt;แบ่งเงิน 2 วัตถุประสงค์&lt;/b&gt;&lt;br&gt;1. Job Search Budget&lt;br&gt;2. เงินสำรองก่อนเงินเดือนแรก" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A63C7;strokeWidth=2;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1020" y="320" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="m4" value="เริ่มมีรายได้แล้ว?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7DA;strokeColor=#E0AA28;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1390" y="325" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="m5no" value="&lt;b&gt;ยังหางานอยู่&lt;/b&gt;&lt;br&gt;Career Mode ยังทำงานต่อ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1640" y="270" width="220" height="85" as="geometry"/></mxCell>
        <mxCell id="m5yes" value="&lt;b&gt;ได้งานและเริ่มมีรายได้&lt;/b&gt;&lt;br&gt;เสนอสร้างเงินสำรองฉุกเฉิน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1640" y="430" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="m6protect" value="&lt;b&gt;ไปหน้า 02 — Transfer Protection&lt;/b&gt;&lt;br&gt;ธุรกรรมทุกครั้งถูกประเมินก่อนเงินออก" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A63C7;strokeWidth=2;dashed=1;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="2000" y="260" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="m6build" value="&lt;b&gt;ไปหน้า 03 — Reserve Builder&lt;/b&gt;&lt;br&gt;ตั้งเป้า 3–6 เดือนและ Auto-Routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#5B93D3;strokeWidth=2;dashed=1;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="2000" y="430" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="m7" value="&lt;b&gt;เงินสำรองฉุกเฉินเติบโต&lt;/b&gt;&lt;br&gt;ติดตามยอด เป้าหมาย และจำนวนเดือนที่ครอบคลุม" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2A8F6D;strokeWidth=2;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="2370" y="430" width="270" height="105" as="geometry"/></mxCell>
        <mxCell id="m8" value="&lt;b&gt;เมื่อต้องการนำเงินออก&lt;/b&gt;&lt;br&gt;ไปหน้า 03 — Withdrawal Paths&lt;br&gt;เลือก friction ตามบริบท" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;strokeWidth=2;dashed=1;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="2710" y="425" width="200" height="115" as="geometry"/></mxCell>
        <mxCell id="main-note" value="&lt;b&gt;คำจำกัดความ:&lt;/b&gt; เงินสำรองก่อนเงินเดือนแรก = เงินระยะสั้นระหว่างเริ่มงานและรอเงินเดือน • เงินสำรองฉุกเฉิน = เงินระยะยาวหลังเริ่มมีรายได้ สำหรับเหตุจำเป็นหรือช่วงรายได้สะดุด" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7F6;strokeColor=#B8C8C3;fontSize=13;spacing=12;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="750" width="2900" height="75" as="geometry"/></mxCell>
        <mxCell id="e-m0-m1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3E6C5D;strokeWidth=2;endArrow=classic;" edge="1" source="m0" target="m1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-m1-m2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3E6C5D;strokeWidth=2;endArrow=classic;" edge="1" source="m1" target="m2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-m2-m3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3E6C5D;strokeWidth=2;endArrow=classic;" edge="1" source="m2" target="m3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-m3-m4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E0AA28;strokeWidth=2;endArrow=classic;" edge="1" source="m3" target="m4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-m4-no" value="ยังไม่มีรายได้" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#49A987;strokeWidth=2;endArrow=classic;fontSize=12;" edge="1" source="m4" target="m5no" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-m4-yes" value="เริ่มมีรายได้" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B93D3;strokeWidth=2;endArrow=classic;fontSize=12;" edge="1" source="m4" target="m5yes" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-no-protect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A63C7;strokeWidth=2;endArrow=classic;" edge="1" source="m5no" target="m6protect" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-yes-build" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B93D3;strokeWidth=2;endArrow=classic;" edge="1" source="m5yes" target="m6build" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-build-growth" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2A8F6D;strokeWidth=2;endArrow=classic;" edge="1" source="m6build" target="m7" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-growth-withdraw" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6A033;strokeWidth=2;endArrow=classic;" edge="1" source="m7" target="m8" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="transfer-protection-v3" name="02 Transfer Protection">
    <mxGraphModel dx="3000" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="1100" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="K PLUS JobShield — Transfer Protection" style="text;html=1;strokeColor=none;fillColor=none;fontSize=30;fontStyle=1;fontColor=#12352B;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1600" height="50" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="แยกแต่ละระดับความเสี่ยงเป็นคนละแถว เพื่อไม่ให้เส้นของ Low, Medium, High และ Break-glass ตัดกัน" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontColor=#49645C;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="82" width="1900" height="35" as="geometry"/></mxCell>
        <mxCell id="input-zone" value="INPUT &amp; POLICY" style="swimlane;html=1;rounded=1;startSize=42;fillColor=#F1EBFF;swimlaneFillColor=#FBF9FF;strokeColor=#8A63C7;fontSize=16;fontStyle=1;fontColor=#5D3998;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="1350" height="830" as="geometry"/></mxCell>
        <mxCell id="action-zone" value="RISK-BASED ACTIONS" style="swimlane;html=1;rounded=1;startSize=42;fillColor=#FFF6DE;swimlaneFillColor=#FFFCF5;strokeColor=#E0AA28;fontSize=16;fontStyle=1;fontColor=#7C5B0D;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1430" y="150" width="1520" height="830" as="geometry"/></mxCell>
        <mxCell id="t0" value="&lt;b&gt;เริ่มรายการใน K PLUS&lt;/b&gt;&lt;br&gt;ผู้รับ • ยอด • แหล่งเงิน • วัตถุประสงค์กว้าง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A63C7;strokeWidth=2;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="450" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="t1" value="&lt;b&gt;Transaction Context Bundle&lt;/b&gt;&lt;br&gt;• Career Mode และแหล่งเงิน&lt;br&gt;• ผู้รับใหม่/เดิม บัญชีบุคคล/verified&lt;br&gt;• ยอดและการแบ่งยอดซ้ำ&lt;br&gt;• Destination risk จำลอง&lt;br&gt;• วัตถุประสงค์ที่ผู้ใช้กรอกเอง&lt;br&gt;&lt;font color=&quot;#725D90&quot;&gt;ไม่อ่านข้อความหรืออีเมล&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A63C7;strokeWidth=2;fontSize=13;spacing=10;align=left;" vertex="1" parent="1"><mxGeometry x="410" y="365" width="330" height="270" as="geometry"/></mxCell>
        <mxCell id="t2" value="&lt;b&gt;Context-aware Multi-signal Policy&lt;/b&gt;&lt;br&gt;MVP ใช้ deterministic rules กับ synthetic data&lt;br&gt;ไม่พึ่งคำตอบเดียวและไม่แสดงสูตรตรวจจับทั้งหมด" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9DFFF;strokeColor=#7549B3;strokeWidth=2;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="810" y="420" width="310" height="160" as="geometry"/></mxCell>
        <mxCell id="t3" value="เลือกระดับ&lt;br&gt;การแทรกแซง" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7549B3;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="435" width="180" height="130" as="geometry"/></mxCell>
        <mxCell id="low" value="&lt;b&gt;LOW&lt;/b&gt;&lt;br&gt;ผู้รับ/ช่องทางตรวจสอบแล้ว และบริบทตรงแผน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F7EC;strokeColor=#48A66D;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1490" y="205" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="low-action" value="ตรวจสอบและโอนตามปกติ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#48A66D;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1810" y="210" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="low-result" value="ส่งคำสั่งเข้าสู่ระบบโอน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2A8F6D;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="2110" y="210" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="med" value="&lt;b&gt;MEDIUM&lt;/b&gt;&lt;br&gt;พบความผิดปกติบางส่วน แต่ยังไม่ถึงระดับ High" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D8;strokeColor=#E99B32;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1490" y="355" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="med-action" value="คำเตือนตามบริบท 2–3 เหตุผล&lt;br&gt;ให้ยืนยันอย่างตั้งใจ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E99B32;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1810" y="355" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="med-choice" value="ผู้ใช้เลือก" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E99B32;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2110" y="355" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="med-send" value="ยืนยันต่อ&lt;br&gt;ส่งคำสั่งโอน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F7EC;strokeColor=#48A66D;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="2360" y="330" width="200" height="75" as="geometry"/></mxCell>
        <mxCell id="med-cancel" value="Pause / ยกเลิก&lt;br&gt;เงินยังไม่ถูกส่ง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F5;strokeColor=#7D8C87;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="2360" y="430" width="200" height="75" as="geometry"/></mxCell>
        <mxCell id="high" value="&lt;b&gt;HIGH&lt;/b&gt;&lt;br&gt;หลายสัญญาณร่วม เช่น จ่ายเพื่อเริ่มงาน + ผู้รับใหม่ + เงินสำรอง + destination risk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE5DF;strokeColor=#DD6B55;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1490" y="545" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="pending" value="&lt;b&gt;Pending Instruction&lt;/b&gt;&lt;br&gt;พักเฉพาะคำสั่งและยอดนี้&lt;br&gt;ยังไม่ส่งเข้า PromptPay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1EE;strokeColor=#DD6B55;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1810" y="550" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="cool" value="&lt;b&gt;Cooling-off แบบ Risk-based&lt;/b&gt;&lt;br&gt;Dynamic Time Lock อยู่ในขั้นนี้&lt;br&gt;กดซ้ำไม่ข้ามเงื่อนไข" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="2110" y="550" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="verify" value="&lt;b&gt;Independent Verification&lt;/b&gt;&lt;br&gt;ตรวจผ่านเว็บไซต์หรือเบอร์ทางการที่ค้นหาเอง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#668FCC;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="2430" y="550" width="245" height="110" as="geometry"/></mxCell>
        <mxCell id="high-choice" value="ผลการตรวจสอบ" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#668FCC;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2740" y="555" width="170" height="100" as="geometry"/></mxCell>
        <mxCell id="high-result" value="ยืนยันต่อ / Cancel / Report&lt;br&gt;หลังผ่านเงื่อนไขที่กำหนด" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8C87;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="2675" y="705" width="235" height="85" as="geometry"/></mxCell>
        <mxCell id="break" value="&lt;b&gt;BREAK-GLASS&lt;/b&gt;&lt;br&gt;บัญชีตนเองหรือ verified biller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F2FF;strokeColor=#5B93D3;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1490" y="815" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="break-action" value="เตือนยอดเงินคงเหลือหนึ่งครั้ง&lt;br&gt;ไม่มี High-Risk delay แบบตายตัว" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1810" y="810" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="break-result" value="ผู้ใช้ยืนยันและใช้เงินได้" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F7EC;strokeColor=#48A66D;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="2130" y="820" width="230" height="80" as="geometry"/></mxCell>
