<mxfile host="app.diagrams.net" agent="Codex" compressed="false" pages="4">
  <diagram id="v6-lifecycle" name="01 ภาพรวมสำหรับผู้บริหาร">
    <mxGraphModel dx="1780" dy="990" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;fontColor=#174C3C;align=left;" value="K PLUS JobShield — ออมเงินสำรองต่อเนื่อง และช่วยหยุดคิดก่อนเงินออก" vertex="1">
          <mxGeometry height="45" width="1300" x="50" y="25" as="geometry" />
        </mxCell>
        <mxCell id="p1-sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontColor=#49645C;align=left;" value="สำหรับ First Jobbers: เริ่มออมได้ด้วยเงินก้อนเล็ก ออมเองหรืออัตโนมัติ เห็นความคืบหน้า และได้รับการปกป้องก่อนเงินออก" vertex="1">
          <mxGeometry height="35" width="1700" x="50" y="70" as="geometry" />
        </mxCell>
        <mxCell id="p1-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8F6;strokeColor=#B7C9C2;fontSize=14;spacing=8;align=left;" value="&lt;b&gt;JobShield คืออะไร?&lt;/b&gt; K-ePocket เป็นที่เก็บเงิน ส่วน JobShield เพิ่มแผนออมอัตโนมัติ ข้อเสนอดอกเบี้ยแบบขั้นบันได Save Point และการตรวจความเสี่ยงก่อนนำเงินสำรองออก" vertex="1">
          <mxGeometry height="55" width="2300" x="50" y="115" as="geometry" />
        </mxCell>
        <mxCell id="p1-phase1" parent="1" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#F4FBF8;swimlaneFillColor=#E7F6F0;strokeColor=#49A987;fontSize=15;fontStyle=1;fontColor=#174C3C;" value="1. เริ่มต้น — เตรียมเงินสำรองตั้งหลัก" vertex="1">
          <mxGeometry height="300" width="850" x="50" y="195" as="geometry" />
        </mxCell>
        <mxCell id="p1-s1" parent="p1-phase1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;strokeWidth=2;fontSize=13;spacing=6;" value="&lt;b&gt;มี K-ePocket อยู่แล้วหรือยัง?&lt;br&gt;&lt;/b&gt;&lt;strong&gt;มีแล้ว:&lt;/strong&gt; เลือก K-ePocket ที่ต้องการใช้&amp;nbsp;&lt;div&gt;หรือสร้างกระเป๋าใหม่&lt;b&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;strong&gt;ยังไม่มี:&lt;/strong&gt; เปิด K-ePocket ตามขั้นตอนปกติของธนาคาร&lt;/div&gt;" vertex="1">
          <mxGeometry height="208.75" width="270" x="260" y="60.620000000000005" as="geometry" />
        </mxCell>
        <mxCell id="p1-s0" parent="p1-phase1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;strong&gt;เลือกเปิดใช้งาน JobShield&lt;/strong&gt;&lt;br&gt;ผู้ใช้สามารถเปิดใช้งานได้ด้วยตนเอง และ รับทราบว่าระบบจะใช้ข้อมูลใดในการประเมินความเสี่ยง" vertex="1">
          <mxGeometry height="120" width="215" x="10" y="105" as="geometry" />
        </mxCell>
        <mxCell id="p1-e01" edge="1" parent="p1-phase1" source="p1-s0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#49A987;strokeWidth=2;" target="p1-s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-phase2" parent="1" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#F7FAFF;swimlaneFillColor=#EAF3FF;strokeColor=#5B93D3;fontSize=15;fontStyle=1;fontColor=#285F9C;" value="2. เติมเงินสำรอง — ออมเองหรือออมอัตโนมัติ" vertex="1">
          <mxGeometry height="300" width="560" x="930" y="195" as="geometry" />
        </mxCell>
        <mxCell id="p1-a1" parent="p1-phase2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;เลือกวิธีที่จะออมเงินสำรองฉุกเฉิน&lt;/b&gt;&lt;br&gt;&lt;b&gt;ออมด้วยตนเอง&lt;/b&gt;&amp;nbsp;ผู้ใช้สามารถเติมเงิน&lt;br&gt;เข้ากระเป๋าได้เอง เริ่มต้นตั้งแต่ 1 บาท&lt;br&gt;&lt;b&gt;ออมให้อัตโนมัติ:&lt;/b&gt;&amp;nbsp;เลือก K-ePocket &lt;br&gt;ที่ต้องการจะออม แล้วกำหนดจำนวนเงินที่ต้องการจะออม และวันที่ที่ผู้ใช้ต้องการ&lt;br&gt;ให้ระบบโอนเงินเข้าไปใน Pocket นั้นแบบอัตโนมัติ โดยจะระบบกำหนดขั้นต่ำ 100 บาทต่อการออมในแต่ละรอบ" vertex="1">
          <mxGeometry height="159.37" width="270" x="20" y="85.31" as="geometry" />
        </mxCell>
        <mxCell id="p1-a2" parent="p1-phase2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;เมื่อถึงวันที่กำหนด&lt;/b&gt;&lt;br&gt;ถ้าผู้ใช้้ลือกแบบ&lt;br&gt;&lt;b&gt;ออมให้อัตโนมัติ&lt;/b&gt;ระบบ&lt;br&gt;จะโอนเงินจากบัญชีผู้ใช้ &lt;br&gt;ไปยัง K-ePocket ที่ผู้ใช้เลือกสำหรับเก็บเป็นเงินสำรองฉุกเฉิน และจะมีการแจ้งผลให้ผู้ใช้ทราบ" vertex="1">
          <mxGeometry height="140" width="220" x="320" y="95" as="geometry" />
        </mxCell>
        <mxCell id="p1-e04" edge="1" parent="p1-phase2" source="p1-a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B93D3;strokeWidth=2;" target="p1-a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-phase3" parent="1" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#FFFDF6;swimlaneFillColor=#FFF4D9;strokeColor=#D6A033;fontSize=15;fontStyle=1;fontColor=#6B5200;" value="3. เห็นความคืบหน้า — ดอกเบี้ย Save Point และ Benefit Tier" vertex="1">
          <mxGeometry height="300" width="830" x="1520" y="195" as="geometry" />
        </mxCell>
        <mxCell id="p1-b1" parent="p1-phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6A033;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;สร้าง Save Point&lt;/b&gt;&lt;br&gt;เมื่อยอดเงินสำรองฉุกเฉินถึงแต่ละ Milestone ระบบจะกำหนด &lt;strong&gt;Save Point&lt;/strong&gt; เป็นยอดขั้นต่ำ&lt;div&gt;ที่ต้องคงไว้&lt;br&gt;เช่น เป้าหมาย 30,000 บาท เมื่อถึงระดับ &lt;strong&gt;Bronze&lt;/strong&gt; จะมี Save Point ที่ 10,000 บาท และ ถ้ายอดเงินสำรองฉุกเฉินลดต่ำกว่าจุด Save Point จะทำให้ผู้ใช้เสีย K-Point Streak แล้วผู้ใช้จะไม้ได้โบนัส K-Point ตามที่วางแผนเอาไว้&lt;/div&gt;" vertex="1">
          <mxGeometry height="184.68" width="270" x="10" y="72.64999999999999" as="geometry" />
        </mxCell>
        <mxCell id="p1-s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;กำหนดเป้าหมายเงินสำรอง&lt;/b&gt;&lt;br&gt;ค่าใช้จ่ายจำเป็นต่อเดือน × 3 หรือ 6 เดือน แล้วเลือกยอดเริ่มต้น&lt;br&gt;แนวคิดต้นแบบเปิดให้เริ่มออมได้ตั้งแต่ 1 บาท" vertex="1">
          <mxGeometry height="110" width="250" x="610" y="305" as="geometry" />
        </mxCell>
        <mxCell id="p1-b2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6A033;strokeWidth=2;fontSize=13;spacing=8;" value="&lt;b&gt;ข้อเสนอดอกเบี้ยแบบขั้นบันได*&lt;/b&gt;&lt;br&gt;1–10,000 บาท: 2.50%&amp;nbsp;ต่อปี&lt;br&gt;10,001–100,000 บาท: 1.50%&amp;nbsp;ต่อปี&lt;br&gt;ส่วนที่เกิน 100,000 บาท: 0.25% ต่อปี" vertex="1">
          <mxGeometry height="130" width="220" x="1830" y="295" as="geometry" />
        </mxCell>
        <mxCell id="p1-dash" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2A8F6D;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;หน้าสรุปสถานะเงินสำรองฉุกเฉิน&lt;/b&gt;&lt;br&gt;แสดงยอดเงินเทียบกับเป้าหมาย จำนวนเดือนที่เงินสำรองครอบคลุม &lt;span&gt;Save Point ปัจจุบัน แผนออม ดอกเบี้ย และสิทธิประโยชน์ที่&lt;/span&gt;&lt;div&gt;&lt;span&gt;ยังได้รับอยู่&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="220" x="2090" y="305" as="geometry" />
        </mxCell>
        <mxCell id="p1-e02" edge="1" parent="1" source="p1-s1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#49A987;strokeWidth=2;" target="p1-s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e03" edge="1" parent="1" source="p1-s2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B93D3;strokeWidth=2;" target="p1-a1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e05" edge="1" parent="1" source="p1-a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D6A033;strokeWidth=2;" target="p1-b1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e06" edge="1" parent="1" source="p1-b1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D6A033;strokeWidth=2;" target="p1-b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e07" edge="1" parent="1" source="p1-b2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2A8F6D;strokeWidth=2;" target="p1-dash">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-out" parent="1" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#FFFDF8;swimlaneFillColor=#FFF6DF;strokeColor=#D6A033;fontSize=15;fontStyle=1;fontColor=#6B5200;" value="4. ก่อนนำเงินออก — เตือนให้ทบทวนและตรวจความเสี่ยง" vertex="1">
          <mxGeometry height="550" width="2000" x="320" y="560" as="geometry" />
        </mxCell>
        <mxCell id="p1-continue" parent="p1-out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2A8F6D;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;ผู้ใช้ยังเป็นผู้ตัดสินใจ&lt;/b&gt;&lt;br&gt;ผู้ใช้สามารถเลือกได้ว่าจะ&amp;nbsp;&lt;div&gt;&lt;strong&gt;ใช้เงินต่อ • เก็บไว้ •&amp;nbsp;&lt;/strong&gt;&lt;/div&gt;&lt;div&gt;&lt;strong&gt;ตรวจสอบเพิ่มเติม •&amp;nbsp;&lt;/strong&gt;&lt;/div&gt;&lt;div&gt;หรือ&amp;nbsp;&lt;strong&gt;ยกเลิกรายการ&lt;/strong&gt;&lt;br&gt;จากนั้น&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;เมื่อดำเนินการเสร็จ&lt;br&gt;&amp;nbsp;ระบบจะพากลับไปยัง &lt;br&gt;&lt;/span&gt;&lt;b&gt;หน้าสรุปสถานะเงินสำรองฉุกเฉิน&lt;/b&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="260" x="1440" y="160" as="geometry" />
        </mxCell>
        <mxCell id="p1-high" parent="p1-out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDE8;strokeColor=#E66C57;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;strong&gt;พบความเสี่ยงสูง&lt;/strong&gt;&lt;br&gt;แสดงเหตุผลของความเสี่ยงอย่างชัดเจน &lt;br&gt;โดยไม่ใช้มาสคอต ระบบจะ&lt;strong&gt;พักเฉพาะรายการโอนที่มีความเสี่ยงไว้ก่อนเงินออกจากบัญชี&lt;/strong&gt; &lt;br&gt;โดยที่จะไม่กระทบธุรกรรมอื่น&lt;br&gt;ผู้ใช้สามารถเลือกที่จะกด&amp;nbsp;&lt;strong&gt;ตรวจสอบต่อ,&lt;/strong&gt;&lt;br&gt;&amp;nbsp;&lt;strong&gt;ยกเลิกรายการ &lt;/strong&gt;หรือ&amp;nbsp;&lt;b&gt;รายงานบัญชี&lt;/b&gt; ได้&lt;br&gt;เนื่องจากผู้ใช้อาจรู้สึกว่ารายการเสี่ยงแต่ยังไม่แน่ใจ&lt;br&gt;ว่าเป็นมิจฉาชีพ ดังนั้นจึงมีปุ่มให้กดรายงานบัญชี&lt;br&gt;&lt;div&gt;เช่น ถ้า&amp;nbsp;&lt;span&gt;นาย A เป็นผู้ใช้ JobShield และกำลังโอนเงินสำรองไปให้นาย B และพบว่า&amp;nbsp;&lt;/span&gt;พบว่า B มีความเสี่ยง ระบบจะทำการ&amp;nbsp;&lt;strong&gt;พักเฉพาะรายการ A → B ชั่วคราว (&lt;/strong&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Cooling-off&amp;nbsp;30 นาที&lt;/strong&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;)&amp;nbsp;&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ซึ่ง A ยังสามารถใช้บัญชี และสามมารถ โอนให้ C จ่ายบิล หรือทำรายการอื่นได้ตามปกติ แต่ถ้านาย&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;B ตรงกับ &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Blacklist ระบบจะไม่ทำการ&amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Cooling-off ซึ่งระบบจะ&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;พักเฉพาะรายการ A → B &lt;br&gt;จนกว่าจะมีเจ้าหน้าที่มาตรวจสอบ และ ยืนยันข้อมูล&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="320" width="355" x="990" y="210" as="geometry" />
        </mxCell>
        <mxCell id="p1-e14" edge="1" parent="p1-out" source="p1-high" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.7;endArrow=block;endFill=1;strokeColor=#2A8F6D;strokeWidth=2;" target="p1-continue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-foot" parent="p1-out" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#6A6A6A;align=left;" value="* อัตราดอกเบี้ย 2.5% / 1.5% / 0.25%, Save Point Tier, โบนัส K Point และสัญญาณเครือข่ายบัญชีม้าเป็น Product Hypothesis สำหรับ Prototype ต้องผ่านการทดสอบและการอนุมัติจากธนาคาร โดย MVP ใช้ข้อมูลความเสี่ยงสังเคราะห์" vertex="1">
          <mxGeometry height="35" width="2250" x="-250" y="490" as="geometry" />
        </mxCell>
        <mxCell id="p1-w1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6A033;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;ผู้ใช้ต้องการนำเงินสำรองออก&lt;/b&gt;&lt;br&gt;ระบุจำนวนเงิน และ บัญชีของผู้รับ" vertex="1">
          <mxGeometry height="100" width="230" x="390" y="730" as="geometry" />
        </mxCell>
        <mxCell id="p1-w2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A63C7;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;ประเมินความเสี่ยงจากหลายปัจจัย&lt;/b&gt;&lt;br&gt;เงินมาจาก&lt;span style=&quot;&quot;&gt;เงินสำรองที่ผู้ใช้ตั้งใจแยกไว้เป็นก้อนสำคัญ&lt;/span&gt;&amp;nbsp;• ผู้รับใหม่หรือบัญชีบุคคล • &lt;br&gt;รูปแบบการโอน • บัญชีปลายทางมีความ&lt;br&gt;เสี่ยงสูงจาก Blacklist หรือความเชื่อมโยงเครือข่ายบัญชีม้า*" vertex="1">
          <mxGeometry height="120" width="270" x="700" y="720" as="geometry" />
        </mxCell>
        <mxCell id="p1-wd" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;strokeWidth=2;fontSize=13;fontStyle=1;" value="พบปัจจัยเสี่ยงหลายอย่างพร้อมกันหรือไม่?" vertex="1">
          <mxGeometry height="140" width="180" x="1050" y="710" as="geometry" />
        </mxCell>
