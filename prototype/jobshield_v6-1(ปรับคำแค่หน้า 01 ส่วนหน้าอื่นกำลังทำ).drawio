  <diagram id="v6-autobenefit" name="02 การออมและสิทธิประโยชน์">
    <mxGraphModel dx="1271" dy="707" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0" />
