          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-boundary" value="แยกให้ชัด — ของเดิม / สิ่งที่ JobShield เพิ่ม / สิ่งที่ยังต้องยืนยัน" style="swimlane;html=1;rounded=1;startSize=40;fillColor=#FAFAFA;swimlaneFillColor=#EFEFEF;strokeColor=#999999;fontSize=16;fontStyle=1;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="50" y="470" width="2300" height="230" as="geometry" />
        </mxCell>
        <mxCell id="p4-reuse" value="&lt;b&gt;ของเดิมที่นำมาใช้ต่อ&lt;/b&gt;&lt;br&gt;K-ePocket • การฝาก ถอน และโอนผ่าน K PLUS&lt;br&gt;กลไกตั้งรายการล่วงหน้า • ระบบ K Point&lt;br&gt;การยืนยันตัวตน • การแจ้งเตือน • ช่องทางรายงาน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7EF;strokeColor=#49A987;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="110" y="550" width="600" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p4-proposed" value="&lt;b&gt;สิ่งที่ JobShield เสนอเพิ่ม&lt;/b&gt;&lt;br&gt;เติมเองตั้งแต่ 1 บาท • Auto-Routing ขั้นต่ำ 100 บาท/รอบ&lt;br&gt;ดอกเบี้ยขั้นบันได • Save Point และ Benefit Tier&lt;br&gt;Savings Nudge • Multi-signal Policy • Cooling-off ก่อนส่งเข้าระบบโอน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="550" width="650" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p4-assume" value="&lt;b&gt;สิ่งที่ต้องยืนยันกับธนาคาร&lt;/b&gt;&lt;br&gt;โอนตามแผนเข้ากระเป๋าเป้าหมายโดยตรง • ขั้นต่ำ 100 บาท/รอบ&lt;br&gt;ต้นทุนและความเป็นธรรมของ 2.5% / 1.5% / 0.25%&lt;br&gt;500 K Point • Bank-side Risk Flag/Graph • กฎ Cooling-off จริง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EC;strokeColor=#E66C57;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1620" y="540" width="650" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p4-looplane" value="คุณค่าที่คาดหวังต่อผู้ใช้และธนาคาร — เป็นสมมติฐานที่ต้องพิสูจน์" style="swimlane;html=1;rounded=1;startSize=40;fillColor=#F7FAFF;swimlaneFillColor=#EAF3FF;strokeColor=#5B93D3;fontSize=16;fontStyle=1;fontColor=#285F9C;" vertex="1" parent="1">
          <mxGeometry x="50" y="745" width="2300" height="290" as="geometry" />
        </mxCell>
        <mxCell id="p4-v1" value="&lt;b&gt;เริ่มออมง่ายและออมต่อเนื่องขึ้น&lt;/b&gt;&lt;br&gt;เริ่มจากเงินก้อนเล็ก และไม่ต้องจำทำรายการทุกเดือน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="855" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4-v2" value="&lt;b&gt;รักษาเงินสำรองได้ดีขึ้น&lt;/b&gt;&lt;br&gt;Save Point แสดงผลก่อนถอน โดยยังไม่ปิดกั้นเหตุฉุกเฉิน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="855" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4-v3" value="&lt;b&gt;เงินฝากอาจมีเสถียรภาพขึ้น&lt;/b&gt;&lt;br&gt;ช่วยสนับสนุนฐานเงินทุนและ Engagement&lt;br&gt;แต่ไม่ถือว่าเงินฝากทุกบาทกลายเป็นสินเชื่อหรือกำไรโดยตรง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="940" y="845" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p4-v4" value="&lt;b&gt;ธนาคารออกแบบ Benefit คืนได้&lt;/b&gt;&lt;br&gt;เมื่อพฤติกรรมและ Economics พิสูจน์ได้&lt;br&gt;ภายใต้ต้นทุน ความเสี่ยง กฎเกณฑ์ และ Business Approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1390" y="845" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p4-v5" value="&lt;b&gt;วงจรคุณค่าที่ต้องพิสูจน์&lt;/b&gt;&lt;br&gt;แรงจูงใจเหมาะสม → ออมต่อเนื่อง → เงินสำรองดีขึ้น → Trust และ Engagement เพิ่ม" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2A8F6D;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1870" y="855" width="340" height="100" as="geometry" />
        </mxCell>
