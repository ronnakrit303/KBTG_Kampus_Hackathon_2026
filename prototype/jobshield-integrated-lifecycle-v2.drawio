  <diagram id="jobshield-integrated-v2" name="Integrated JobShield Flow">
    <mxGraphModel dx="3200" dy="2300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3200" pageHeight="2300" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="K PLUS JobShield — Integrated Build &amp; Protect Flow" style="text;html=1;strokeColor=none;fillColor=none;fontSize=32;fontStyle=1;fontColor=#12352B;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1900" height="55" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="เส้นทางเดียวตั้งแต่ช่วงสมัครงาน ไปจนถึงการสร้างเงินสำรองฉุกเฉินและปกป้องเงินก่อนโอนไปยังธุรกรรมเสี่ยง" style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontColor=#49645C;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="82" width="2200" height="35" as="geometry"/></mxCell>
        <mxCell id="legend" value="เส้นทึบ = การทำงานหลักของผู้ใช้&amp;nbsp;&amp;nbsp; • &amp;nbsp;&amp;nbsp;เส้นประ = ข้อมูลจำลอง แนวคิดในอนาคต หรือการวนกลับ&amp;nbsp;&amp;nbsp; • &amp;nbsp;&amp;nbsp;MVP ใช้ deterministic rules และ synthetic data — ยังไม่เรียกว่า AI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7F6;strokeColor=#B8C8C3;fontSize=13;fontColor=#36524A;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="50" y="125" width="3100" height="48" as="geometry"/></mxCell>

        <mxCell id="phase1" value="PHASE 1 — ช่วงสมัครงานและรอเงินเดือนแรก: จัดเงินให้ชัดก่อนเปิดการป้องกัน" style="swimlane;html=1;rounded=1;startSize=46;fillColor=#EAF8F3;swimlaneFillColor=#F8FCFA;strokeColor=#49A987;fontSize=18;fontStyle=1;fontColor=#165E47;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="50" y="195" width="3100" height="410" as="geometry"/></mxCell>
        <mxCell id="a0" value="&lt;b&gt;First Jobber กำลังสมัครงาน&lt;/b&gt;&lt;br&gt;มีเงินก้อนสำหรับค่าใช้จ่ายระหว่างหางาน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;strokeWidth=2;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="285" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="a1" value="&lt;b&gt;เปิด JobShield / Career Mode&lt;/b&gt;&lt;br&gt;Opt-in • ตั้งวันหมดอายุ • ปิดได้ทุกเมื่อ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2A8F6D;strokeWidth=2;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="410" y="285" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="a2" value="มี K-ePocket&lt;br&gt;แล้วหรือยัง?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7DA;strokeColor=#E0AA28;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="275" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="a3n" value="&lt;b&gt;ยังไม่มี&lt;/b&gt;&lt;br&gt;เสนอสร้าง 2 กระเป๋าแบบ One-tap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1030" y="250" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="a3y" value="&lt;b&gt;มีแล้ว&lt;/b&gt;&lt;br&gt;เชื่อมกระเป๋าเดิมเข้ากับ JobShield" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1030" y="370" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="a4budget" value="&lt;b&gt;Job Search Budget&lt;/b&gt;&lt;br&gt;ค่าเดินทาง เอกสาร ค่าสอบ และค่าใช้จ่ายหางานตามแผน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#5B93D3;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1340" y="250" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="a4reserve" value="&lt;b&gt;เงินสำรองก่อนเงินเดือนแรก&lt;/b&gt;&lt;br&gt;ค่าเช่า อาหาร เดินทาง และเหตุจำเป็นจนกว่าจะได้รับเงินเดือน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A63C7;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1340" y="390" width="270" height="105" as="geometry"/></mxCell>
        <mxCell id="a5" value="&lt;b&gt;กำหนดขอบเขต&lt;/b&gt;&lt;br&gt;จำนวนเงินแต่ละส่วน ระยะเวลา วันหมดอายุ และสิทธิ์แก้ไข" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1690" y="310" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="a6" value="&lt;b&gt;Career Mode พร้อมใช้งาน&lt;/b&gt;&lt;br&gt;JobShield ทำงานเมื่อผู้ใช้เริ่มโอน&lt;br&gt;&lt;font color=&quot;#49645C&quot;&gt;ไม่อ่านข้อความหรืออีเมล&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2A8F6D;strokeWidth=2;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="2050" y="300" width="310" height="115" as="geometry"/></mxCell>
        <mxCell id="a7" value="&lt;b&gt;Lifecycle checkpoint&lt;/b&gt;&lt;br&gt;ยังหางาน → ใช้ Career Mode ต่อ&lt;br&gt;ได้งานแล้ว → ไปสร้างเงินสำรองฉุกเฉิน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="2460" y="295" width="320" height="125" as="geometry"/></mxCell>
        <mxCell id="a8" value="เริ่มมีรายได้แล้ว?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7DA;strokeColor=#E0AA28;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2870" y="295" width="200" height="120" as="geometry"/></mxCell>

        <mxCell id="phase2" value="PHASE 2 — ทุกครั้งที่เริ่มโอน: ประเมินความเสี่ยงก่อนเงินออก" style="swimlane;html=1;rounded=1;startSize=46;fillColor=#F1EBFF;swimlaneFillColor=#FBF9FF;strokeColor=#8A63C7;fontSize=18;fontStyle=1;fontColor=#5D3998;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="50" y="635" width="3100" height="660" as="geometry"/></mxCell>
        <mxCell id="b0" value="&lt;b&gt;เริ่มรายการใน K PLUS&lt;/b&gt;&lt;br&gt;ผู้รับ • ยอด • แหล่งเงิน • วัตถุประสงค์กว้าง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A63C7;strokeWidth=2;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="750" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="b1" value="&lt;b&gt;สัญญาณจากบริบทธุรกรรม&lt;/b&gt;&lt;br&gt;Career Mode • Budget/Reserve • ผู้รับใหม่/เดิม • บัญชีบุคคล • ยอด/การแบ่งยอดซ้ำ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A63C7;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="440" y="700" width="330" height="125" as="geometry"/></mxCell>
        <mxCell id="b2" value="&lt;b&gt;Destination risk จำลอง&lt;/b&gt;&lt;br&gt;ธงความเสี่ยงปลายทางจากระบบธนาคารสมมติใน Prototype" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="440" y="875" width="330" height="105" as="geometry"/></mxCell>
        <mxCell id="b3" value="&lt;b&gt;ข้อมูลที่ผู้ใช้กรอกเอง&lt;/b&gt;&lt;br&gt;วัตถุประสงค์เป็นเพียงหนึ่ง signal ไม่ใช่ปุ่มข้ามระบบ&lt;br&gt;&lt;font color=&quot;#725D90&quot;&gt;ไม่มี Email/Link scanning ใน Core&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A63C7;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="440" y="1030" width="330" height="125" as="geometry"/></mxCell>
        <mxCell id="b4" value="&lt;b&gt;Context-aware Multi-signal Policy&lt;/b&gt;&lt;br&gt;รวมหลายสัญญาณด้วย deterministic rules&lt;br&gt;ลดความเสี่ยงเมื่อผู้รับ/ช่องทางตรวจสอบแล้ว และค่าใช้จ่ายตรงแผน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9DFFF;strokeColor=#7549B3;strokeWidth=2;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="850" y="830" width="360" height="145" as="geometry"/></mxCell>
        <mxCell id="b5" value="ระดับการ&lt;br&gt;แทรกแซง" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7549B3;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1290" y="835" width="210" height="135" as="geometry"/></mxCell>
        <mxCell id="bLow" value="&lt;b&gt;LOW&lt;/b&gt;&lt;br&gt;ตรวจสอบและโอนตามปกติ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F7EC;strokeColor=#48A66D;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1590" y="695" width="245" height="80" as="geometry"/></mxCell>
        <mxCell id="bMed" value="&lt;b&gt;MEDIUM&lt;/b&gt;&lt;br&gt;คำเตือนตามบริบท 2–3 เหตุผล&lt;br&gt;ให้ยืนยันอย่างตั้งใจ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D8;strokeColor=#E99B32;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1590" y="815" width="245" height="100" as="geometry"/></mxCell>
        <mxCell id="bHigh" value="&lt;b&gt;HIGH&lt;/b&gt;&lt;br&gt;Pause &amp; Verify&lt;br&gt;แสดงเหตุผลและเงินสำรองที่กำลังเสี่ยง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE5DF;strokeColor=#DD6B55;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1590" y="955" width="245" height="105" as="geometry"/></mxCell>
        <mxCell id="bBreak" value="&lt;b&gt;BREAK-GLASS&lt;/b&gt;&lt;br&gt;บัญชีตนเองหรือ verified biller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F2FF;strokeColor=#5B93D3;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1590" y="1110" width="245" height="85" as="geometry"/></mxCell>
        <mxCell id="bSend" value="&lt;b&gt;ส่งคำสั่งเข้าสู่ระบบโอน&lt;/b&gt;&lt;br&gt;เมื่อผ่านเงื่อนไขแล้ว" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#48A66D;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1930" y="695" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="bMedDecision" value="ผู้ใช้เลือก&lt;br&gt;ยืนยัน / Pause / ยกเลิก" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E99B32;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1940" y="815" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="bPending" value="&lt;b&gt;Pending Instruction&lt;/b&gt;&lt;br&gt;พักเฉพาะคำสั่งและยอดนี้&lt;br&gt;&lt;font color=&quot;#A14332&quot;&gt;ยังไม่ส่งเข้า PromptPay&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1EE;strokeColor=#DD6B55;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1920" y="960" width="270" height="105" as="geometry"/></mxCell>
        <mxCell id="bCool" value="&lt;b&gt;Cooling-off แบบ Risk-based&lt;/b&gt;&lt;br&gt;Dynamic Time Lock อยู่ในขั้นนี้&lt;br&gt;กดซ้ำไม่สร้างรายการใหม่หรือข้ามเงื่อนไข" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="2280" y="945" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="bVerify" value="&lt;b&gt;Independent Verification&lt;/b&gt;&lt;br&gt;ตรวจผ่านเว็บไซต์หรือเบอร์ทางการที่ค้นหาเอง&lt;br&gt;ไม่ใช้ลิงก์จากข้อความต้องสงสัย" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#668FCC;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="2660" y="945" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="bFinal" value="ผลการตรวจสอบ" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#668FCC;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2980" y="1070" width="150" height="100" as="geometry"/></mxCell>
        <mxCell id="bBreakNote" value="เตือนยอดเงินคงเหลือ&lt;br&gt;ไม่มี High-Risk delay แบบตายตัว" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1930" y="1110" width="250" height="85" as="geometry"/></mxCell>
        <mxCell id="bCancel" value="&lt;b&gt;Cancel / Report&lt;/b&gt;&lt;br&gt;ยกเลิกก่อนเงินออก และเก็บเฉพาะ audit indicators ที่จำเป็น" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F5;strokeColor=#7D8C87;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="2660" y="1145" width="300" height="105" as="geometry"/></mxCell>

        <mxCell id="phase3" value="PHASE 3 — หลังเริ่มมีรายได้: สร้างเงินสำรองฉุกเฉินด้วย Auto-Routing" style="swimlane;html=1;rounded=1;startSize=46;fillColor=#EAF3FF;swimlaneFillColor=#F8FBFF;strokeColor=#5B93D3;fontSize=18;fontStyle=1;fontColor=#245B98;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="50" y="1325" width="3100" height="455" as="geometry"/></mxCell>
        <mxCell id="c0" value="&lt;b&gt;ผู้ใช้เริ่มงาน / กำลังจะได้รับเงินเดือนแรก&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#49645C&quot;&gt;Prototype ใช้ salary event จำลองหรือวันที่ผู้ใช้กำหนด&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="1425" width="290" height="105" as="geometry"/></mxCell>
        <mxCell id="c1" value="&lt;b&gt;เริ่มสร้างเงินสำรองฉุกเฉิน&lt;/b&gt;&lt;br&gt;เงินระยะยาวสำหรับเหตุจำเป็นหรือช่วงรายได้สะดุด" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF8F3;strokeColor=#49A987;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="440" y="1425" width="285" height="105" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;b&gt;คำนวณเป้าหมาย&lt;/b&gt;&lt;br&gt;ค่าใช้จ่ายจำเป็นต่อเดือน × 3 / 6 เดือน / กำหนดเอง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="785" y="1425" width="285" height="105" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;เปรียบเทียบแผนออม&lt;/b&gt;&lt;br&gt;จำนวนคงที่ หรือ 5% / 10% / 15% / กำหนดเอง&lt;br&gt;แสดงระยะเวลาประมาณการ ไม่บังคับเลือก" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1130" y="1410" width="310" height="130" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;Review &amp; Consent&lt;/b&gt;&lt;br&gt;บัญชีต้นทาง • จำนวน/เปอร์เซ็นต์ • กระเป๋าปลายทาง • เพดาน • รอบถัดไป&lt;br&gt;แก้ไข Pause หรือปิดได้" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A63C7;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1500" y="1405" width="330" height="140" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;Salary Event / Schedule&lt;/b&gt;&lt;br&gt;Auto-Routing ตรวจยอดที่ต้องแบ่งและเพดาน&lt;br&gt;ใช้ idempotency ป้องกันการแบ่งซ้ำ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#5B93D3;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1890" y="1415" width="310" height="120" as="geometry"/></mxCell>
        <mxCell id="c6" value="ถึงเพดานแล้ว?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7DA;strokeColor=#E0AA28;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2260" y="1420" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="c7route" value="แบ่งเงินเข้า&lt;br&gt;เงินสำรองฉุกเฉิน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2A8F6D;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="2500" y="1385" width="220" height="85" as="geometry"/></mxCell>
        <mxCell id="c7stop" value="หยุด Auto-Routing&lt;br&gt;เมื่อถึงเป้าหมาย" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="2500" y="1515" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;Dashboard ความคืบหน้า&lt;/b&gt;&lt;br&gt;ยอดปัจจุบัน • เป้าหมาย • จำนวนเดือนที่ครอบคลุม • milestone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2A8F6D;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="2790" y="1405" width="300" height="115" as="geometry"/></mxCell>
        <mxCell id="cReward" value="&lt;b&gt;Future Reward Concept&lt;/b&gt;&lt;br&gt;K Point/สิทธิพิเศษเมื่อเติมเงินหรือถึง milestone&lt;br&gt;ดอกเบี้ยพิเศษยังไม่ระบุอัตรา และต้องผ่าน Business/Product approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;dashed=1;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="2790" y="1570" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="cNote" value="&lt;b&gt;หลักสำคัญ:&lt;/b&gt; ให้รางวัลจากการเติมเงินหรือถึง milestone ไม่ลงโทษผู้ใช้ที่ถอนเงินเพื่อเหตุฉุกเฉินจริง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7F6;strokeColor=#B8C8C3;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="1625" width="1740" height="65" as="geometry"/></mxCell>

        <mxCell id="phase4" value="PHASE 4 — เมื่อต้องการนำเงินสำรองฉุกเฉินออก: ใช้ friction ให้พอดีกับบริบท" style="swimlane;html=1;rounded=1;startSize=46;fillColor=#FFF6DE;swimlaneFillColor=#FFFCF5;strokeColor=#E0AA28;fontSize=18;fontStyle=1;fontColor=#7C5B0D;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="50" y="1810" width="3100" height="430" as="geometry"/></mxCell>
        <mxCell id="d0" value="&lt;b&gt;ผู้ใช้เลือกนำเงินออก&lt;/b&gt;&lt;br&gt;ระบุยอด ปลายทาง และวัตถุประสงค์กว้าง&lt;br&gt;ระบบแสดงยอด/จำนวนเดือนคงเหลือ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0AA28;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="100" y="1915" width="310" height="120" as="geometry"/></mxCell>
        <mxCell id="d1" value="ปลายทางและ&lt;br&gt;บริบทเป็นแบบใด?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0AA28;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="1915" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="d2" value="&lt;b&gt;เหตุจำเป็นที่ตรวจสอบได้&lt;/b&gt;&lt;br&gt;บัญชีตนเองหรือ verified biller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F2FF;strokeColor=#5B93D3;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="820" y="1865" width="285" height="85" as="geometry"/></mxCell>
        <mxCell id="d3" value="&lt;b&gt;ค่าใช้จ่ายทั่วไป&lt;/b&gt;&lt;br&gt;ไม่ใช่ Fraud finding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="820" y="1985" width="285" height="80" as="geometry"/></mxCell>
        <mxCell id="d4" value="&lt;b&gt;หลายสัญญาณเสี่ยงสูง&lt;/b&gt;&lt;br&gt;ผู้รับใหม่/บัญชีบุคคล + การแบ่งยอด/จ่ายเพื่อเริ่มงาน + destination risk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE5DF;strokeColor=#DD6B55;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="820" y="2100" width="285" height="105" as="geometry"/></mxCell>
        <mxCell id="d2a" value="เตือนยอดคงเหลือหนึ่งครั้ง&lt;br&gt;แล้วให้ยืนยันใช้เงินได้&lt;br&gt;ไม่มี High-Risk delay แบบตายตัว" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1200" y="1860" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="d3a" value="&lt;b&gt;Friendly Character Nudge&lt;/b&gt;&lt;br&gt;“หากใช้ครั้งนี้ เงินสำรองจะเหลือประมาณ X เดือน”&lt;br&gt;เก็บไว้ก่อน / ยังต้องการใช้" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1200" y="1980" width="320" height="105" as="geometry"/></mxCell>
        <mxCell id="d4a" value="ส่งกลับเข้า High-Risk flow&lt;br&gt;Warning → Pending Instruction → Cooling-off → Verify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1EE;strokeColor=#DD6B55;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1200" y="2110" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="dOutcome" value="&lt;b&gt;ผลลัพธ์สำหรับผู้ใช้&lt;/b&gt;&lt;br&gt;• ใช้เงินฉุกเฉินได้เมื่อจำเป็นจริง&lt;br&gt;• มีจังหวะคิดก่อนใช้เงินทั่วไป&lt;br&gt;• ได้รับการป้องกันเพิ่มเมื่อกำลังโอนไปยังธุรกรรมที่เสี่ยง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF8F3;strokeColor=#49A987;strokeWidth=2;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1630" y="1890" width="390" height="145" as="geometry"/></mxCell>
        <mxCell id="securityNote" value="&lt;b&gt;Security &amp; Privacy Boundary&lt;/b&gt;&lt;br&gt;• Pause เฉพาะคำสั่งโอนและจำนวนเงินที่กำลังเสี่ยง — ไม่ล็อกบัญชีหรือ K-ePocket ทั้งก้อน&lt;br&gt;• การถอนเงินสำรองเพียงอย่างเดียวไม่ถือว่าเป็น Fraud&lt;br&gt;• เก็บข้อมูลเท่าที่จำเป็น ขอ consent ตามวัตถุประสงค์ และใช้ encryption/access control ตามมาตรฐานธนาคารใน Production&lt;br&gt;• ระบบช่วยลดความเสี่ยง แต่ไม่รับประกันว่าจะหยุด Scam ได้ทุกกรณี" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A63C7;strokeWidth=2;fontSize=13;spacing=10;align=left;" vertex="1" parent="1"><mxGeometry x="2120" y="1880" width="970" height="165" as="geometry"/></mxCell>
        <mxCell id="businessNote" value="&lt;b&gt;Business hypotheses — ยังไม่ใช่ผลที่พิสูจน์แล้ว:&lt;/b&gt; อาจเพิ่ม engagement/retention และความสม่ำเสมอของยอดเงินฝาก รวมถึงลดภาระ Scam support บางส่วน • ไม่กล่าวว่าธนาคารนำเงินก้อนนี้ไปลงทุนต่อได้โดยตรง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7F6;strokeColor=#B8C8C3;fontSize=12;spacing=10;align=left;" vertex="1" parent="1"><mxGeometry x="1630" y="2100" width="1460" height="80" as="geometry"/></mxCell>

