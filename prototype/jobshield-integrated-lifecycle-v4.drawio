        <mxCell id="p2-em" value="&lt;b&gt;เหตุฉุกเฉินที่ตรวจสอบได้&lt;/b&gt;&lt;br&gt;บัญชีตนเอง / Verified Biller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F2FF;strokeColor=#5B93D3;strokeWidth=2;fontSize=13;spacing=9;" vertex="1" parent="1">
