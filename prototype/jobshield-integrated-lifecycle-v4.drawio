  <diagram id="build-reserve-v4" name="02 Build Reserve">
    <mxGraphModel dx="3000" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="1250" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2-title" value="K PLUS JobShield — Build Reserve" style="text;html=1;strokeColor=none;fillColor=none;fontSize=30;fontStyle=1;fontColor=#12352B;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="25" width="1700" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2-sub" value="สร้างเงินสำรองฉุกเฉินแบบผู้ใช้ควบคุมได้ และแยก Savings Nudge ออกจาก Fraud/Scam Intervention" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontColor=#49645C;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="78" width="2200" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p2-build-lane" value="BUILD — ตั้งเป้าและ Auto-Routing" style="swimlane;html=1;rounded=1;startSize=42;fillColor=#EAF3FF;swimlaneFillColor=#F8FBFF;strokeColor=#5B93D3;fontSize=17;fontStyle=1;fontColor=#245B98;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="140" width="2900" height="360" as="geometry" />
        </mxCell>
        <mxCell id="p2-b0" value="&lt;b&gt;เริ่มหรือเปลี่ยน Stage&lt;/b&gt;&lt;br&gt;ยืนยันยอดตั้งต้น หรือเริ่ม Pocket ใหม่" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;strokeWidth=2;fontSize=13;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="90" y="270" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-b1" value="&lt;b&gt;ค่าใช้จ่ายจำเป็นต่อเดือน&lt;/b&gt;&lt;br&gt;เช่น ค่าเช่า อาหาร เดินทาง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;strokeWidth=2;fontSize=13;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="430" y="270" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-b2" value="&lt;b&gt;เลือกเป้าหมาย&lt;/b&gt;&lt;br&gt;3 เดือน • 6 เดือน • กำหนดเอง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;strokeWidth=2;fontSize=13;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="760" y="270" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-b3" value="&lt;b&gt;ตั้ง Auto-Routing&lt;/b&gt;&lt;br&gt;จำนวนคงที่หรือ % • หยุดเมื่อถึงเป้าหมาย" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#5B93D3;strokeWidth=2;fontSize=13;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="1090" y="260" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2-b4" value="&lt;b&gt;Review &amp; Consent&lt;/b&gt;&lt;br&gt;Source • Destination • Cap • Next route&lt;br&gt;Edit / Pause / Off" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;strokeWidth=2;fontSize=13;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="1440" y="255" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2-b5" value="&lt;b&gt;Auto-Routing ทำงาน&lt;/b&gt;&lt;br&gt;แสดง receipt แบบเงียบ ไม่เตือน Scam ทุกครั้ง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2A8F6D;strokeWidth=2;fontSize=13;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="1800" y="270" width="270" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-b6" value="&lt;b&gt;Reserve Dashboard&lt;/b&gt;&lt;br&gt;ยอด • เป้าหมาย • เดือนที่ครอบคลุม&lt;br&gt;K Point = Future Concept" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2A8F6D;strokeWidth=2;fontSize=13;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="2150" y="255" width="290" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2-b7" value="&lt;b&gt;ผู้ใช้ควบคุมได้เสมอ&lt;/b&gt;&lt;br&gt;ปรับ • พัก • ปิด • เปลี่ยนเป้าหมาย" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;strokeWidth=2;fontSize=13;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="2520" y="270" width="270" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-withdraw-lane" value="WHEN MONEY GOES OUT — เลือกการแทรกแซงตามเหตุผลจริง" style="swimlane;html=1;rounded=1;startSize=42;fillColor=#FFF6DE;swimlaneFillColor=#FFFCF5;strokeColor=#E0AA28;fontSize=17;fontStyle=1;fontColor=#7C5B0D;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="550" width="2900" height="600" as="geometry" />
        </mxCell>
        <mxCell id="p2-w0" value="&lt;b&gt;Entry จาก Dashboard&lt;/b&gt;&lt;br&gt;ผู้ใช้ต้องการนำเงินออก" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6A033;strokeWidth=2;dashed=1;fontSize=13;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="100" y="790" width="240" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p2-w1" value="&lt;b&gt;แสดงผลกระทบก่อนยืนยัน&lt;/b&gt;&lt;br&gt;ยอดคงเหลือและเดือนที่ครอบคลุม" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6A033;strokeWidth=2;fontSize=13;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="420" y="780" width="270" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p2-w2" value="ปลายทางและ&lt;br&gt;ความเสี่ยงเป็นแบบใด?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6A033;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
