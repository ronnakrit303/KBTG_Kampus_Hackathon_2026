  <diagram id="protect-transfer-v4" name="03 Protect Transfer">
    <mxGraphModel dx="3000" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="1150" math="0" shadow="0" adaptiveColors="auto">
      <root>
