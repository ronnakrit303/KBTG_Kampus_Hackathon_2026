        <mxCell id="p1-e-stage-inc" edge="1" parent="1" source="p1-stage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B93D3;strokeWidth=2;endArrow=classic;fontSize=12;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" target="p1-inc1" value="ได้รับเงินเดือนแล้ว">
          <mxGeometry relative="1" as="geometry">
