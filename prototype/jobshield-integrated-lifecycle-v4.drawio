        <mxCell id="p2-em-action" value="เตือนยอดคงเหลือหนึ่งครั้ง&lt;br&gt;ยืนยันใช้เงินได้ ไม่มี High-Risk delay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;fontSize=13;spacing=9;" vertex="1" parent="1">
