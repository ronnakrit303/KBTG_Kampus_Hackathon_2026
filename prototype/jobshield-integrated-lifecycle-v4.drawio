<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36" compressed="false" version="29.6.6" pages="3">
  <diagram id="product-lifecycle-v4" name="01 Product Lifecycle">
    <mxGraphModel dx="1061" dy="582" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="1050" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=30;fontStyle=1;fontColor=#12352B;align=left;" value="K PLUS JobShield — Product Lifecycle" vertex="1">
          <mxGeometry height="50" width="1700" x="50" y="25" as="geometry" />
        </mxCell>
        <mxCell id="p1-sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontColor=#49645C;align=left;" value="ผลิตภัณฑ์เดียวตั้งแต่จัดเงิน สร้างเงินสำรอง ไปจนปกป้องก่อนโอน — อ่านจากซ้ายไปขวาและเลือกเพียงหนึ่งแถวตามช่วงชีวิต" vertex="1">
          <mxGeometry height="35" width="2300" x="50" y="78" as="geometry" />
        </mxCell>
        <mxCell id="p1-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7F6;strokeColor=#B8C8C3;fontSize=13;fontColor=#36524A;align=left;spacingLeft=14;" value="กล่องขอบประ = จุดไปยังหน้ารายละเอียด • ระบบไม่เปลี่ยนวัตถุประสงค์ของเงินอัตโนมัติ • ทุก External Transfer กลับเข้าสู่ Protect policy เดียวกัน" vertex="1">
          <mxGeometry height="50" width="2900" x="50" y="120" as="geometry" />
        </mxCell>
        <mxCell id="p1-start" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2A8F6D;strokeWidth=2;fontSize=14;spacing=10;" value="User สามารถเปิดใช้งาน &lt;br&gt;JobShield ได้ทันที โดยไม่ต้องสร้าง K-ePocket ไว้ล่วงหน้า" vertex="1">
          <mxGeometry height="100" width="230" x="60" y="430" as="geometry" />
        </mxCell>
        <mxCell id="p1-stage" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7DA;strokeColor=#E0AA28;strokeWidth=2;fontSize=14;fontStyle=1;align=center;" value="&lt;pre dir=&quot;ltr&quot;&gt;&lt;code&gt;คุณได้รับเงินเดือน&lt;br&gt;จากงานแล้วหรือยัง?&lt;/code&gt;&lt;/pre&gt;" vertex="1">
          <mxGeometry height="130" width="190" x="370" y="415" as="geometry" />
        </mxCell>
        <mxCell id="p1-pre-lane" parent="1" style="swimlane;html=1;rounded=1;startSize=42;fillColor=#EAF8F3;swimlaneFillColor=#F8FCFA;strokeColor=#49A987;fontSize=17;fontStyle=1;fontColor=#165E47;pointerEvents=0;" value="ก่อนรับเงินเดือนแรก" vertex="1">
          <mxGeometry height="310" width="2300" x="650" y="190" as="geometry" />
        </mxCell>
        <mxCell id="p1-pre3" parent="p1-pre-lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A63C7;strokeWidth=2;fontSize=14;spacing=10;" value="&lt;b&gt;กันเงินสำรองก้อนเดียว&lt;/b&gt;&lt;br&gt;ผู้ใช้นำเงินที่มีอยู่มากันเป็น&lt;br&gt;&lt;b&gt;เงินสำรองก่อนเงินเดือนแรก&lt;/b&gt;&lt;br&gt;สำหรับค่าใช้ชีวิตที่จำเป็น" vertex="1">
          <mxGeometry height="135" width="325" x="675" y="90" as="geometry" />
        </mxCell>
        <mxCell id="p1-pre2" parent="p1-pre-lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;strokeWidth=2;fontSize=14;spacing=10;" value="ระบบจะทำการเชื่อมต่อกับ&amp;nbsp;&lt;div&gt;K-ePocket ที่มีอยู่&amp;nbsp;&lt;div&gt;หรือ&amp;nbsp;&lt;/div&gt;&lt;div&gt;ถ้า User ยังไม่มี&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;K-ePocket&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ระบบสามารถสร้าง&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;K-ePocket&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;ใหม่ได้ทันที เพียงกดแค่ปุ่มเดียว&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="260" x="370" y="92.5" as="geometry" />
        </mxCell>
        <mxCell id="p1-e-pre2-pre3" edge="1" parent="p1-pre-lane" source="p1-pre2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#49A987;strokeWidth=2;endArrow=classic;" target="p1-pre3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-pre4" parent="p1-pre-lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;strokeWidth=2;fontSize=14;spacing=10;" value="&lt;b&gt;ทยอยใช้เมื่อจำเป็น&lt;/b&gt;&lt;br&gt;ค่าเช่า • ค่าอาหาร • ค่าเดินทางไปทำงาน&lt;br&gt;พร้อมดูยอดและระยะเวลาที่เงินยังครอบคลุม" vertex="1">
          <mxGeometry height="100" width="310" x="1050" y="107.5" as="geometry" />
        </mxCell>
        <mxCell id="p1-e-pre3-pre4" edge="1" parent="p1-pre-lane" source="p1-pre3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#49A987;strokeWidth=2;endArrow=classic;" target="p1-pre4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-pre1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;strokeWidth=2;fontSize=14;spacing=10;" value="&lt;b&gt;เลือก Stage&lt;/b&gt;&lt;br&gt;กำลังหางาน หรือได้งานแล้วแต่ยังไม่ได้รับเงินเดือนแรก" vertex="1">
          <mxGeometry height="95" width="240" x="720" y="300" as="geometry" />
        </mxCell>
        <mxCell id="p1-pre5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A63C7;strokeWidth=2;dashed=1;fontSize=14;spacing=10;" value="&lt;b&gt;ไปหน้า 03 — Protect Transfer&lt;/b&gt;&lt;br&gt;เมื่อผู้ใช้กำลังโอนเงินออกไปยังบัญชีอื่น" vertex="1">
          <mxGeometry height="95" width="280" x="2050" y="300" as="geometry" />
        </mxCell>
        <mxCell id="p1-transition" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;dashed=1;fontSize=13;spacing=10;" value="&lt;b&gt;หลังได้รับเงินเดือนแรก&lt;/b&gt;&lt;br&gt;ผู้ใช้ยืนยันว่าจะเปลี่ยนเงินก้อนเดิมเป็นเงินสำรองฉุกเฉิน หรือเริ่ม Pocket ใหม่" vertex="1">
          <mxGeometry height="125" width="460" x="2410" y="285" as="geometry" />
        </mxCell>
        <mxCell id="p1-income-lane" parent="1" style="swimlane;html=1;rounded=1;startSize=42;fillColor=#EAF3FF;swimlaneFillColor=#F8FBFF;strokeColor=#5B93D3;fontSize=17;fontStyle=1;fontColor=#245B98;pointerEvents=0;" value="หลังเริ่มรับเงินเดือน" vertex="1">
          <mxGeometry height="310" width="2300" x="650" y="570" as="geometry" />
        </mxCell>
        <mxCell id="p1-inc1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;strokeWidth=2;fontSize=14;spacing=10;" value="&lt;b&gt;เลือก Stage&lt;/b&gt;&lt;br&gt;ได้รับเงินเดือนแล้ว" vertex="1">
          <mxGeometry height="95" width="240" x="720" y="680" as="geometry" />
        </mxCell>
        <mxCell id="p1-inc2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;strokeWidth=2;fontSize=14;spacing=10;" value="&lt;b&gt;ตั้งเงินสำรองฉุกเฉิน&lt;/b&gt;&lt;br&gt;ใช้ยอดเดิมเมื่อยืนยัน หรือเริ่มใหม่" vertex="1">
          <mxGeometry height="95" width="250" x="1040" y="680" as="geometry" />
        </mxCell>
        <mxCell id="p1-inc3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#5B93D3;strokeWidth=2;dashed=1;fontSize=14;spacing=10;" value="&lt;b&gt;ไปหน้า 02 — Build Reserve&lt;/b&gt;&lt;br&gt;เป้าหมาย 3–6 เดือน + Auto-Routing" vertex="1">
          <mxGeometry height="95" width="280" x="1370" y="680" as="geometry" />
        </mxCell>
        <mxCell id="p1-inc4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2A8F6D;strokeWidth=2;fontSize=14;spacing=10;" value="&lt;b&gt;ติดตามเงินสำรอง&lt;/b&gt;&lt;br&gt;ยอด เป้าหมาย และจำนวนเดือนที่ครอบคลุม" vertex="1">
          <mxGeometry height="105" width="270" x="1730" y="675" as="geometry" />
        </mxCell>
        <mxCell id="p1-inc5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A63C7;strokeWidth=2;dashed=1;fontSize=14;spacing=10;" value="&lt;b&gt;ไปหน้า 03 — Protect Transfer&lt;/b&gt;&lt;br&gt;ทุกครั้งที่โอนไปภายนอก" vertex="1">
          <mxGeometry height="95" width="280" x="2080" y="680" as="geometry" />
        </mxCell>
        <mxCell id="p1-inc6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2A8F6D;strokeWidth=2;fontSize=14;spacing=10;" value="&lt;b&gt;Continue&lt;/b&gt;&lt;br&gt;อัปเดตยอดและปรับแผนได้เสมอ" vertex="1">
          <mxGeometry height="95" width="270" x="2440" y="680" as="geometry" />
        </mxCell>
        <mxCell id="p1-e-start-stage" edge="1" parent="1" source="p1-start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3E6C5D;strokeWidth=2;endArrow=classic;" target="p1-stage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e-stage-pre" edge="1" parent="1" source="p1-stage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#49A987;strokeWidth=2;endArrow=classic;fontSize=12;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" target="p1-pre1" value="ยังไม่ได้รับเงินเดือนแรก">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="610" y="454" />
