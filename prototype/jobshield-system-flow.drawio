          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e6" value="ต้องการนำเงินออก" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7549B3;strokeWidth=2;endArrow=block;fontSize=12;" edge="1" parent="1" source="r04" target="r05">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7549B3;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="r05" target="r06">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e8" value="ตนเอง / verified biller" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B93D3;strokeWidth=2;endArrow=block;fontSize=12;" edge="1" parent="1" source="r06" target="r09a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e9" value="ค่าใช้จ่ายทั่วไป" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6A033;strokeWidth=2;endArrow=block;fontSize=12;" edge="1" parent="1" source="r06" target="r09b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e10" value="หลายสัญญาณเสี่ยง" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DD6B55;strokeWidth=2;endArrow=block;fontSize=12;" edge="1" parent="1" source="r06" target="r09c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
