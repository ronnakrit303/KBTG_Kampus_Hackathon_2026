  <diagram id="jobshield-reserve" name="03 Auto-Routing &amp; Reserve">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3-title" value="K PLUS JobShield — จากเงินสำรองก่อนเงินเดือนแรกสู่เงินสำรองฉุกเฉิน" style="text;html=1;strokeColor=none;fillColor=none;fontSize=30;fontStyle=1;fontColor=#12352B;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1800" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3-sub" value="Supporting flow หลังผู้ใช้เริ่มมีรายได้: Auto-Routing เป็น opt-in และการถอนเงินใช้ friction ตามบริบท" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontColor=#49645C;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="85" width="1800" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p3-build" value="BUILD — ช่วยสร้างเงินสำรอง" style="swimlane;html=1;rounded=1;startSize=45;fillColor=#EAF8F3;swimlaneFillColor=#F8FCFA;strokeColor=#49A987;fontSize=17;fontStyle=1;fontColor=#165E47;" vertex="1" parent="1">
          <mxGeometry x="50" y="160" width="1510" height="570" as="geometry" />
        </mxCell>
        <mxCell id="r00" value="&lt;b&gt;เริ่มงานและกำลังจะได้รับเงินเดือนแรก&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#49645C&quot;&gt;เหตุการณ์เงินเดือนเป็นข้อมูลจำลองใน Prototype&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;strokeWidth=2;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="250" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="r01" value="&lt;b&gt;คำนวณเป้าหมาย&lt;/b&gt;&lt;br&gt;ค่าใช้จ่ายจำเป็นต่อเดือน × 3/6 เดือนหรือกำหนดเอง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="250" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="r02" value="&lt;b&gt;ตั้ง Auto-Routing&lt;/b&gt;&lt;br&gt;จำนวนคงที่ หรือ 5% / 10% / 15% / กำหนดเอง&lt;br&gt;ตั้งเพดานและหยุดเมื่อถึงเป้าหมาย" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#5B93D3;strokeWidth=2;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="730" y="235" width="310" height="130" as="geometry" />
        </mxCell>
        <mxCell id="r03" value="&lt;b&gt;ตรวจสอบและให้ความยินยอม&lt;/b&gt;&lt;br&gt;แสดงบัญชีต้นทาง จำนวน/เปอร์เซ็นต์ กระเป๋าปลายทาง เพดาน และวันถัดไป&lt;br&gt;แก้ไข • Pause • ปิดได้" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A63C7;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1090" y="225" width="330" height="145" as="geometry" />
        </mxCell>
        <mxCell id="r04" value="&lt;b&gt;Dashboard ความคืบหน้า&lt;/b&gt;&lt;br&gt;ยอดปัจจุบัน / เป้าหมาย / จำนวนเดือนที่ครอบคลุม&lt;br&gt;ให้ badge จากการเติมเงินหรือถึง milestone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2A8F6D;strokeWidth=2;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="590" y="470" width="370" height="130" as="geometry" />
        </mxCell>
        <mxCell id="reward" value="&lt;b&gt;Reward เป็นแนวคิดในอนาคต&lt;/b&gt;&lt;br&gt;K Point หรือดอกเบี้ยพิเศษต้องผ่าน Business/Product, Treasury, Legal และ Regulatory approval&lt;br&gt;ไม่ระบุอัตราใน Prototype" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;dashed=1;fontSize=13;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1030" y="465" width="390" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p3-protect" value="PROTECT — เลือก friction ให้พอดีกับบริบท" style="swimlane;html=1;rounded=1;startSize=45;fillColor=#F1EBFF;swimlaneFillColor=#FBF9FF;strokeColor=#8A63C7;fontSize=17;fontStyle=1;fontColor=#5D3998;" vertex="1" parent="1">
          <mxGeometry x="50" y="780" width="2290" height="560" as="geometry" />
        </mxCell>
        <mxCell id="r05" value="&lt;b&gt;ผู้ใช้ต้องการนำเงินสำรองฉุกเฉินออก&lt;/b&gt;&lt;br&gt;เลือกยอด ปลายทาง และวัตถุประสงค์กว้าง&lt;br&gt;ระบบแสดงยอดคงเหลือหลังทำรายการ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A63C7;strokeWidth=2;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="900" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="r06" value="ปลายทางและบริบทเป็นแบบใด?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7549B3;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="895" width="250" height="135" as="geometry" />
        </mxCell>
        <mxCell id="r09a" value="&lt;b&gt;เหตุจำเป็นที่ตรวจสอบได้&lt;/b&gt;&lt;br&gt;บัญชีตนเองหรือ verified biller&lt;br&gt;เตือนยอดคงเหลือ แต่ไม่มี High-Risk delay แบบตายตัว" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F2FF;strokeColor=#5B93D3;strokeWidth=2;fontSize=13;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="845" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="r09b" value="&lt;b&gt;ค่าใช้จ่ายทั่วไป&lt;/b&gt;&lt;br&gt;ตัวละครเป็นมิตรช่วยเตือนสติว่าเงินสำรองจะลดลง&lt;br&gt;ผู้ใช้เลือก “เก็บไว้ก่อน” หรือ “ยังต้องการใช้” ได้" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;strokeWidth=2;fontSize=13;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="1045" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="r09c" value="&lt;b&gt;โอนไปผู้รับใหม่และมีหลายสัญญาณเสี่ยงสูง&lt;/b&gt;&lt;br&gt;เช่น ถูกขอให้จ่ายเพื่อเริ่มงาน แบ่งยอดซ้ำ หรือ destination risk สูง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE5DF;strokeColor=#DD6B55;strokeWidth=2;fontSize=13;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1290" y="895" width="360" height="130" as="geometry" />
        </mxCell>
        <mxCell id="rhigh" value="&lt;b&gt;เข้าสู่ High-Risk flow เดิม&lt;/b&gt;&lt;br&gt;Contextual warning → Pending Instruction → Cooling-off / Dynamic Time Lock → Verify → Cancel/Report หรือยืนยันต่อ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1EE;strokeColor=#DD6B55;strokeWidth=2;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1750" y="890" width="450" height="140" as="geometry" />
        </mxCell>
        <mxCell id="rule" value="&lt;b&gt;กฎสำคัญ:&lt;/b&gt; การถอนเงินสำรองเพียงอย่างเดียวไม่ถือว่าเป็น Fraud • General-spending nudge ไม่กล่าวหาผู้ใช้หรือผู้รับ • High-Risk ต้องเกิดจากหลายสัญญาณ • Pause เฉพาะคำสั่งโอน ไม่ล็อกเงินทั้งกระเป๋า" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF8F3;strokeColor=#49A987;fontSize=13;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1290" y="1110" width="910" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p3-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3E6C5D;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="r00" target="r01">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B93D3;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="r01" target="r02">
