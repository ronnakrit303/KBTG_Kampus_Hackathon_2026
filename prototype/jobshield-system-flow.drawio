  <diagram id="jobshield-architecture" name="02 Core Integrations">
    <mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2-title" value="K PLUS JobShield — Core Integrations &amp; Trust Boundaries" style="text;html=1;strokeColor=none;fillColor=none;fontSize=30;fontStyle=1;fontColor=#12352B;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1600" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2-sub" value="Core มี 3 integration เท่านั้น • Prototype ใช้ synthetic data • Email/Link scanning และ Fraud Specialist ไม่ใช่ Core" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontColor=#49645C;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="85" width="1800" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p2-user-zone" value="USER / MOBILE TRUST BOUNDARY" style="swimlane;html=1;rounded=1;startSize=45;fillColor=#EAF8F3;swimlaneFillColor=#F8FCFA;strokeColor=#49A987;fontSize=16;fontStyle=1;fontColor=#165E47;" vertex="1" parent="1">
          <mxGeometry x="50" y="155" width="430" height="1040" as="geometry" />
        </mxCell>
        <mxCell id="p2-bank-zone" value="K PLUS / BANK TRUST BOUNDARY" style="swimlane;html=1;rounded=1;startSize=45;fillColor=#F1EBFF;swimlaneFillColor=#FBF9FF;strokeColor=#8A63C7;fontSize=16;fontStyle=1;fontColor=#5D3998;" vertex="1" parent="1">
          <mxGeometry x="520" y="155" width="1260" height="1040" as="geometry" />
        </mxCell>
        <mxCell id="p2-rail-zone" value="PAYMENT RAIL" style="swimlane;html=1;rounded=1;startSize=45;fillColor=#FFF6DE;swimlaneFillColor=#FFFCF5;strokeColor=#E0AA28;fontSize=16;fontStyle=1;fontColor=#7C5B0D;" vertex="1" parent="1">
          <mxGeometry x="1820" y="155" width="330" height="1040" as="geometry" />
        </mxCell>
        <mxCell id="p2-user" value="&lt;b&gt;ผู้ใช้ทำรายการโอน&lt;/b&gt;&lt;br&gt;ผู้รับ • ยอด • แหล่งเงิน • วัตถุประสงค์กว้าง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;strokeWidth=2;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="260" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-consent" value="&lt;b&gt;Consent &amp; Data Minimization&lt;/b&gt;&lt;br&gt;ใช้เฉพาะข้อมูลธุรกรรมที่จำเป็น&lt;br&gt;ไม่มีการอ่านข้อความ/อีเมลอัตโนมัติ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF8F3;strokeColor=#49A987;fontSize=13;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="450" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2-ui" value="&lt;b&gt;K PLUS UI&lt;/b&gt;&lt;br&gt;แสดงเหตุผล 2–3 ข้อ&lt;br&gt;Pause &amp; Verify • Cancel/Report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="700" width="330" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p2-i1" value="&lt;b&gt;Integration 1 — K-ePocket&lt;/b&gt;&lt;br&gt;ระบุ fund source:&lt;br&gt;• Job Search Budget&lt;br&gt;• เงินสำรองก่อนเงินเดือนแรก&lt;br&gt;• เงินสำรองฉุกเฉิน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#5B93D3;strokeWidth=2;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="590" y="250" width="330" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p2-i2" value="&lt;b&gt;Integration 2 — Transaction + Bank-side Fraud Risk&lt;/b&gt;&lt;br&gt;ผู้รับใหม่ • บัญชีบุคคล • ยอด/รูปแบบสะสม&lt;br&gt;destination-risk flag และ device/session signals ที่จำเป็น" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A63C7;strokeWidth=2;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="590" y="465" width="450" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p2-policy" value="&lt;b&gt;Context-aware Policy Engine&lt;/b&gt;&lt;br&gt;Deterministic multi-signal rules ใน MVP&lt;br&gt;จัดระดับ Low / Medium / High / Break-glass&lt;br&gt;&lt;font color=&quot;#725D90&quot;&gt;ไม่ใช้คำว่า AI และไม่แสดง risk percentage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9DFFF;strokeColor=#7549B3;strokeWidth=2;fontSize=15;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1120" y="390" width="390" height="165" as="geometry" />
        </mxCell>
        <mxCell id="p2-i3" value="&lt;b&gt;Integration 3 — Security &amp; Fraud Response&lt;/b&gt;&lt;br&gt;Contextual warning • deliberate confirmation&lt;br&gt;Cooling-off • Pending Instruction • Cancel/Report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D8;strokeColor=#E99B32;strokeWidth=2;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1120" y="670" width="390" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p2-pending" value="&lt;b&gt;Pending Instruction Store&lt;/b&gt;&lt;br&gt;พักเฉพาะคำสั่งและยอดเงิน&lt;br&gt;idempotency ป้องกันกดซ้ำ&lt;br&gt;audit indicators เท่าที่จำเป็น" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1EE;strokeColor=#DD6B55;strokeWidth=2;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1120" y="900" width="390" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p2-rail" value="&lt;b&gt;PromptPay / ระบบโอน&lt;/b&gt;&lt;br&gt;รับคำสั่งเมื่อผ่านเงื่อนไขแล้วเท่านั้น" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0AA28;strokeWidth=2;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1860" y="480" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2-result" value="&lt;b&gt;ผลลัพธ์&lt;/b&gt;&lt;br&gt;สำเร็จ / ยกเลิก / รายงานข้อกังวล" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F7EC;strokeColor=#48A66D;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1860" y="720" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-future" value="&lt;b&gt;OPTIONAL / FUTURE — ไม่ใช่ Core&lt;/b&gt;&lt;br&gt;• ผู้ใช้เลือกส่ง Email/Link ให้ตรวจ โดยขอ consent ทุกครั้ง&lt;br&gt;• Fraud Specialist workflow สำหรับกรณีคลุมเครือ&lt;br&gt;• KBank-verified employer/payment network&lt;br&gt;&lt;font color=&quot;#6C7773&quot;&gt;ต้องตรวจ feasibility, privacy, operation และ Business approval เพิ่มเติม&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F5;strokeColor=#9BA9A4;dashed=1;fontSize=13;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="900" width="450" height="175" as="geometry" />
        </mxCell>
        <mxCell id="p2-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3E6C5D;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="p2-user" target="p2-i1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7549B3;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="p2-user" target="p2-i2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B93D3;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="p2-i1" target="p2-policy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7549B3;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="p2-i2" target="p2-policy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E99B32;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="p2-policy" target="p2-i3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e6" value="High" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DD6B55;strokeWidth=2;endArrow=block;fontStyle=1;" edge="1" parent="1" source="p2-i3" target="p2-pending">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e7" value="ผ่านเงื่อนไข" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#48A66D;strokeWidth=2;endArrow=block;fontSize=12;" edge="1" parent="1" source="p2-i3" target="p2-rail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e8" value="ตรวจสอบครบ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#48A66D;strokeWidth=2;endArrow=block;fontSize=12;" edge="1" parent="1" source="p2-pending" target="p2-rail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#48A66D;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="p2-rail" target="p2-result">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e10" value="คำเตือน/สถานะ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3E6C5D;strokeWidth=2;endArrow=block;fontSize=12;" edge="1" parent="1" source="p2-i3" target="p2-ui">
