        <mxCell id="p2-t2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6A033;strokeWidth=2;fontSize=16;spacing=8;" value="&lt;b&gt;ออมสำเร็จ 3 รอบ&lt;/b&gt;&lt;br&gt;ระดับ ต่อเนื่อง" vertex="1">
          <mxGeometry height="100" width="260" x="790" y="830" as="geometry" />
        </mxCell>
        <mxCell id="p2-t3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6A033;strokeWidth=2;fontSize=16;spacing=8;" value="&lt;b&gt;ออมสำเร็จ 6 รอบ&lt;/b&gt;&lt;br&gt;ระดับ มั่นคง" vertex="1">
          <mxGeometry height="100" width="260" x="1160" y="830" as="geometry" />
        </mxCell>
        <mxCell id="p2-benefit" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;ตัวอย่างสิทธิประโยชน์&lt;/b&gt;&lt;br&gt;อาจเป็น K Point หรือคูปองพาร์ตเนอร์&lt;br&gt;&lt;font color=&quot;#8A5C00&quot;&gt;ต้องผ่านเงื่อนไขและการอนุมัติของธนาคาร&lt;br&gt;ต้นแบบไม่รับรองคะแนนหรือมูลค่า&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="420" x="1530" y="815" as="geometry" />
        </mxCell>
        <mxCell id="p2-e10" edge="1" parent="1" source="p2-count" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;strokeColor=#D6A033;strokeWidth=2;" target="p2-t1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
