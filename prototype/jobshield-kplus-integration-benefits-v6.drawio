        <mxCell id="p2-e11" edge="1" parent="1" source="p2-t1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D6A033;strokeWidth=2;" target="p2-t2">
          <mxGeometry relative="1" as="geometry" />
