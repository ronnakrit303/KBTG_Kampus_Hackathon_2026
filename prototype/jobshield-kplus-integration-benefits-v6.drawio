  <diagram id="v6-protect" name="03 การนำเงินออกและการป้องกัน">
    <mxGraphModel dx="1900" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3-title" value="เมื่อต้องการนำเงินออก — คำเตือนเรื่องการออมและคำเตือนภัยแยกจากกัน" style="text;html=1;strokeColor=none;fillColor=none;fontSize=27;fontStyle=1;fontColor=#6B5200;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="25" width="1900" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p3-note" value="&lt;b&gt;หลักสำคัญ:&lt;/b&gt; การถอนเงินไม่ใช่ Scam โดยตัวมันเอง ระบบจะแสดงคำเตือนภัยร้ายแรงเมื่อพบหลายสัญญาณเสี่ยงร่วมกันเท่านั้น เพื่อลดการเตือนผิดและความรำคาญ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#D6A033;fontSize=14;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="90" width="2500" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3-start" value="&lt;b&gt;ผู้ใช้ขอนำเงินสำรองออก&lt;/b&gt;&lt;br&gt;กรอกยอด เลือกผู้รับ&lt;br&gt;และระบุเหตุผลกว้าง ๆ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6A033;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="440" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3-signals" value="&lt;b&gt;ข้อมูลที่ระบบเห็นในรายการ&lt;/b&gt;&lt;br&gt;เงินมาจากกระเป๋าใด • ยอด • ผู้รับใหม่หรือไม่&lt;br&gt;โอนซ้ำหรือไม่ • เหตุผล • ความเสี่ยงปลายทาง*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A63C7;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="390" y="425" width="310" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p3-policy" value="&lt;b&gt;กติกาประเมินหลายสัญญาณ&lt;/b&gt;&lt;br&gt;รวมข้อมูลหลายข้อ ไม่ตัดสินจากคำตอบเดียว&lt;br&gt;ไม่อ่านข้อความ อีเมล หรือ Resume" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A63C7;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="425" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p3-d" value="พบสัญญาณเสี่ยง&lt;br&gt;หลายข้อพร้อมกัน?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1170" y="415" width="200" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p3-e01" edge="1" parent="1" source="p3-start" target="p3-signals" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A63C7;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e02" edge="1" parent="1" source="p3-signals" target="p3-policy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A63C7;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e03" edge="1" parent="1" source="p3-policy" target="p3-d" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A63C7;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-nlane" value="เส้นทาง A — ไม่พบความเสี่ยงสูง: เตือนด้วยความห่วงใย แต่ผู้ใช้ตัดสินใจได้" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#FFFDF6;swimlaneFillColor=#FFF4D9;strokeColor=#D6A033;fontSize=15;fontStyle=1;fontColor=#6B5200;" vertex="1" parent="1">
          <mxGeometry x="1450" y="185" width="1100" height="300" as="geometry" />
        </mxCell>
        <mxCell id="p3-mascot" value="&lt;b&gt;มาสคอตเตือนสติเรื่องการออม&lt;/b&gt;&lt;br&gt;“ขอชวนคิดอีกครั้งนะ&lt;br&gt;นี่คือเงินสำรองสำหรับเหตุฉุกเฉิน”&lt;br&gt;พร้อมแสดงยอดและจำนวนเดือนที่เหลือ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1510" y="295" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p3-choice" value="ยังต้องการใช้&lt;br&gt;เงินสำรองหรือไม่?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6A033;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1880" y="300" width="170" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3-send" value="&lt;b&gt;ยืนยันใช้เงินสำรอง&lt;/b&gt;&lt;br&gt;ส่งคำสั่งโอนตามปกติ&lt;br&gt;โดยไม่พักรายการ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2A8F6D;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="2130" y="285" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p3-support" value="มาสคอตส่งกำลังใจ:&lt;br&gt;“ขอให้ทุกอย่างผ่านไปได้ด้วยดีนะ”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7EF;strokeColor=#49A987;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="2130" y="400" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3-keep" value="เก็บเงินไว้ก่อน → กลับหน้าสรุป" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8F6;strokeColor=#8CA69D;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1835" y="230" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3-e04" value="ไม่พบ" edge="1" parent="1" source="p3-d" target="p3-mascot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;endArrow=block;endFill=1;strokeColor=#D6A033;fontSize=12;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e05" edge="1" parent="1" source="p3-mascot" target="p3-choice" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D6A033;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e06" value="ใช้" edge="1" parent="1" source="p3-choice" target="p3-send" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2A8F6D;fontSize=12;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e07" value="เก็บ" edge="1" parent="1" source="p3-choice" target="p3-keep" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;strokeColor=#8CA69D;fontSize=12;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e08" edge="1" parent="1" source="p3-send" target="p3-support" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;strokeColor=#49A987;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-hlane" value="เส้นทาง B — พบความเสี่ยงสูง: คำเตือนจริงจังและไม่มีมาสคอต" style="swimlane;html=1;rounded=1;startSize=38;fillColor=#FFF7F5;swimlaneFillColor=#FFE7E1;strokeColor=#E66C57;fontSize=15;fontStyle=1;fontColor=#8A3022;" vertex="1" parent="1">
          <mxGeometry x="1450" y="585" width="1100" height="430" as="geometry" />
        </mxCell>
        <mxCell id="p3-warning" value="&lt;b&gt;คำเตือนตามบริบท&lt;/b&gt;&lt;br&gt;บอกเหตุผลที่สังเกตได้ 2–3 ข้อ&lt;br&gt;และจำนวนเงินสำรองที่กำลังเสี่ยง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDE8;strokeColor=#E66C57;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1510" y="735" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3-pending" value="&lt;b&gt;พักเฉพาะคำสั่งรายการนี้&lt;/b&gt;&lt;br&gt;เงินยังไม่ถูกส่งออก&lt;br&gt;&lt;b&gt;และยังไม่เข้าสู่ระบบโอน PromptPay&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A63C7;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1860" y="735" width="270" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3-hchoice" value="ผู้ใช้ต้องการ&lt;br&gt;ทำอย่างไรต่อ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A63C7;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2210" y="730" width="170" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p3-cancel" value="&lt;b&gt;ยกเลิกและรายงาน&lt;/b&gt;&lt;br&gt;เงินยังไม่ถูกส่ง&lt;br&gt;ส่งข้อมูลเท่าที่จำเป็นเมื่อผู้ใช้ยินยอม" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDE8;strokeColor=#E66C57;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="2160" y="635" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3-verify" value="&lt;b&gt;รอและตรวจสอบอย่างอิสระ&lt;/b&gt;&lt;br&gt;ติดต่อบริษัทผ่านช่องทางที่หาเอง&lt;br&gt;ครบเวลาจึงประเมินซ้ำและยืนยันตัวตนเพิ่ม&lt;br&gt;จากนั้นผู้ใช้จึงยืนยันหรือยกเลิก" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A63C7;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="2160" y="875" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3-e09" value="พบ" edge="1" parent="1" source="p3-d" target="p3-warning" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;endArrow=block;endFill=1;strokeColor=#E66C57;fontSize=12;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e10" edge="1" parent="1" source="p3-warning" target="p3-pending" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A63C7;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e11" edge="1" parent="1" source="p3-pending" target="p3-hchoice" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A63C7;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e12" value="ยกเลิก/รายงาน" edge="1" parent="1" source="p3-hchoice" target="p3-cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;endArrow=block;endFill=1;strokeColor=#E66C57;fontSize=12;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e13" value="พักและตรวจสอบ" edge="1" parent="1" source="p3-hchoice" target="p3-verify" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;strokeColor=#8A63C7;fontSize=12;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-foot" value="* ความเสี่ยงปลายทางในต้นแบบเป็นข้อมูลจำลองจากระบบธนาคาร • JobShield ช่วยลดความเสี่ยง แต่ไม่รับประกันว่าจะหยุด Scam ได้ทุกกรณี" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#6A6A6A;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="1030" width="1800" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v6-integration" name="04 ระบบเดิม สิ่งที่เพิ่ม และคุณค่าธุรกิจ">
    <mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p4-title" value="JobShield ใช้อะไรที่มีอยู่แล้ว เพิ่มอะไร และสร้างคุณค่าอย่างไร" style="text;html=1;strokeColor=none;fillColor=none;fontSize=27;fontStyle=1;fontColor=#174C3C;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="25" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p4-core" value="ระบบทำงานร่วมกับ 3 ส่วนหลักของ K PLUS" style="swimlane;html=1;rounded=1;startSize=40;fillColor=#F4FBF8;swimlaneFillColor=#E7F6F0;strokeColor=#49A987;fontSize=16;fontStyle=1;fontColor=#174C3C;" vertex="1" parent="1">
          <mxGeometry x="50" y="100" width="2300" height="330" as="geometry" />
        </mxCell>
        <mxCell id="p4-i1" value="&lt;b&gt;1. K-ePocket — ที่เก็บเงิน&lt;/b&gt;&lt;br&gt;เก็บเงินสำรอง แสดงยอดและเป้าหมาย&lt;br&gt;บอกว่าเงินก้อนนี้ต้องได้รับการปกป้อง&lt;br&gt;&lt;font color=&quot;#49645C&quot;&gt;ใช้การตั้งโอนล่วงหน้าเป็นฐานการออม&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="225" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p4-i2" value="&lt;b&gt;2. ข้อมูลธุรกรรมและความเสี่ยง&lt;/b&gt;&lt;br&gt;ดูผู้รับ ยอด และรูปแบบการโอน&lt;br&gt;รวมสัญญาณความเสี่ยงปลายทาง&lt;br&gt;ที่ระบบธนาคารอาจมีอยู่แล้ว" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A63C7;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="225" width="360" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p4-i3" value="&lt;b&gt;3. เครื่องมือความปลอดภัย&lt;/b&gt;&lt;br&gt;คำเตือน การยืนยันตัวตน และการแจ้งเตือน&lt;br&gt;การพักคำสั่งตามความเสี่ยง&lt;br&gt;รวมทางยกเลิกและรายงาน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1040" y="225" width="370" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p4-policy" value="&lt;b&gt;JobShield เชื่อมทุกส่วนเข้าด้วยกัน&lt;/b&gt;&lt;br&gt;เป้าหมายเงินสำรอง + แผนออม + ระดับสิทธิประโยชน์&lt;br&gt;รวมกับการประเมินความเสี่ยงก่อนเงินออก&lt;br&gt;&lt;font color=&quot;#174C3C&quot;&gt;นี่คือส่วนแตกต่างหลักของแนวคิด&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2A8F6D;strokeWidth=3;fontSize=15;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1620" y="215" width="410" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p4-e01" edge="1" parent="1" source="p4-i1" target="p4-policy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;entryX=0.2;entryY=0;endArrow=block;endFill=1;strokeColor=#49A987;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="270" y="175" />
              <mxPoint x="1702" y="175" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p4-e02" edge="1" parent="1" source="p4-i2" target="p4-policy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;endArrow=block;endFill=1;strokeColor=#8A63C7;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="740" y="395" />
              <mxPoint x="1825" y="395" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p4-e03" edge="1" parent="1" source="p4-i3" target="p4-policy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;strokeColor=#D6A033;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-boundary" value="แยกให้ชัด — ของเดิม / สิ่งที่ JobShield เพิ่ม / สิ่งที่ยังต้องยืนยัน" style="swimlane;html=1;rounded=1;startSize=40;fillColor=#FAFAFA;swimlaneFillColor=#EFEFEF;strokeColor=#999999;fontSize=16;fontStyle=1;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="50" y="470" width="2300" height="230" as="geometry" />
        </mxCell>
        <mxCell id="p4-reuse" value="&lt;b&gt;ของเดิมที่นำมาใช้ต่อ&lt;/b&gt;&lt;br&gt;K-ePocket • เป้าหมายออม • โอนและจ่าย&lt;br&gt;ตั้งโอนล่วงหน้า • ระบบ K Point&lt;br&gt;ยืนยันใบหน้า • แจ้งเตือน • ช่องทางรายงาน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7EF;strokeColor=#49A987;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="110" y="550" width="600" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p4-proposed" value="&lt;b&gt;สิ่งที่ JobShield เสนอเพิ่ม&lt;/b&gt;&lt;br&gt;คำนวณเป้าหมาย • นับรอบ • ผ่อนผัน • ยอดอ้างอิง&lt;br&gt;ระดับสิทธิประโยชน์ • มาสคอตเตือนการออม&lt;br&gt;ประเมินเงินสำรองและพักคำสั่งก่อนโอน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="550" width="650" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p4-assume" value="&lt;b&gt;สิ่งที่ต้องยืนยันกับธนาคาร&lt;/b&gt;&lt;br&gt;ตรวจจับเงินเดือนเข้า • โอนเข้ากระเป๋าย่อยโดยตรง&lt;br&gt;หยุดอัตโนมัติเมื่อถึงเป้า • ข้อมูลความเสี่ยงจริง&lt;br&gt;เงื่อนไข K Point/คูปอง และต้นทุนโครงการ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EC;strokeColor=#E66C57;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1620" y="540" width="650" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p4-looplane" value="คุณค่าที่คาดหวังต่อผู้ใช้และธนาคาร — เป็นสมมติฐานที่ต้องพิสูจน์" style="swimlane;html=1;rounded=1;startSize=40;fillColor=#F7FAFF;swimlaneFillColor=#EAF3FF;strokeColor=#5B93D3;fontSize=16;fontStyle=1;fontColor=#285F9C;" vertex="1" parent="1">
          <mxGeometry x="50" y="745" width="2300" height="290" as="geometry" />
        </mxCell>
        <mxCell id="p4-v1" value="&lt;b&gt;ผู้ใช้ออมต่อเนื่องขึ้น&lt;/b&gt;&lt;br&gt;ไม่ต้องจำมาทำรายการทุกเดือน" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="855" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4-v2" value="&lt;b&gt;ผู้ใช้มีเงินสำรองดีขึ้น&lt;/b&gt;&lt;br&gt;และกลับมาใช้ K PLUS ต่อเนื่อง" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="855" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4-v3" value="&lt;b&gt;เงินฝากอาจมีเสถียรภาพขึ้น&lt;/b&gt;&lt;br&gt;ช่วยสนับสนุนฐานเงินทุน&lt;br&gt;และโอกาสสร้างคุณค่าให้ธนาคาร" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="940" y="845" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p4-v4" value="&lt;b&gt;ธนาคารพิจารณาสิทธิประโยชน์&lt;/b&gt;&lt;br&gt;ตามต้นทุน ความเสี่ยง และกฎเกณฑ์&lt;br&gt;โดยต้องผ่านการอนุมัติทางธุรกิจ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1390" y="845" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p4-v5" value="&lt;b&gt;ผู้ใช้เห็นแรงจูงใจที่ชัดขึ้น&lt;/b&gt;&lt;br&gt;ระดับ ความคืบหน้า และตัวอย่างสิทธิประโยชน์" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2A8F6D;strokeWidth=2;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1870" y="855" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4-e04" edge="1" parent="1" source="p4-v1" target="p4-v2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B93D3;strokeWidth=2;dashed=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e05" edge="1" parent="1" source="p4-v2" target="p4-v3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B93D3;strokeWidth=2;dashed=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e06" edge="1" parent="1" source="p4-v3" target="p4-v4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B93D3;strokeWidth=2;dashed=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e07" edge="1" parent="1" source="p4-v4" target="p4-v5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D6A033;strokeWidth=2;dashed=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-e08" edge="1" parent="1" source="p4-v5" target="p4-v1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;endArrow=block;endFill=1;strokeColor=#2A8F6D;strokeWidth=2;dashed=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2040" y="1000" />
              <mxPoint x="250" y="1000" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p4-foot" value="ข้อควรระวัง: ไม่อ้างว่าเงินฝากทุกบาทกลายเป็นสินเชื่อหรือกำไรโดยตรง • ไม่รับรองสิทธิประโยชน์ • ต้องทดสอบความต้องการ ต้นทุน และความเป็นธรรมก่อนใช้งานจริง" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#6A6A6A;align=left;" vertex="1" parent="1">
          <mxGeometry x="70" y="1050" width="1900" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
