        <mxCell id="p2-e07" edge="1" parent="1" source="p2-check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D6A033;fontSize=12;" target="p2-count" value="ใช่">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-grace" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8F6;strokeColor=#8CA69D;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;เงินไม่พอ หรือผู้ใช้กดพัก&lt;/b&gt;&lt;br&gt;เดือนนี้ไม่เพิ่มรอบ แต่ระดับเดิมไม่หาย&lt;br&gt;ผ่อนผันได้ 1–2 รอบในต้นแบบ" vertex="1">
          <mxGeometry height="120" width="260" x="1240" y="500" as="geometry" />
        </mxCell>
        <mxCell id="p2-hold" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EC;strokeColor=#E66C57;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;ถอนจนต่ำกว่ายอดอ้างอิง&lt;/b&gt;&lt;br&gt;ระดับเดิมไม่ลด แต่หยุดความคืบหน้า&lt;br&gt;จนกว่าจะเติมเงินกลับถึงจุดเดิม" vertex="1">
          <mxGeometry height="120" width="250" x="1810" y="500" as="geometry" />
        </mxCell>
        <mxCell id="p2-e08" edge="1" parent="1" source="p2-d1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;strokeColor=#8CA69D;fontSize=12;" target="p2-grace" value="ไม่สำเร็จ">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e09" edge="1" parent="1" source="p2-check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;strokeColor=#E66C57;fontSize=12;" target="p2-hold" value="ไม่">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-tierlane" parent="1" style="swimlane;html=1;rounded=1;startSize=40;fillColor=#FFFDF6;swimlaneFillColor=#FFF4D9;strokeColor=#D6A033;fontSize=16;fontStyle=1;fontColor=#6B5200;" value="ระดับสิทธิประโยชน์ — ให้คุณค่ากับความต่อเนื่อง ไม่แข่งขันกันด้วยจำนวนเงิน" vertex="1">
          <mxGeometry height="280" width="1740" x="330" y="720" as="geometry" />
        </mxCell>
        <mxCell id="p2-t1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6A033;strokeWidth=2;fontSize=16;spacing=8;" value="&lt;b&gt;ออมสำเร็จ 1 รอบ&lt;/b&gt;&lt;br&gt;ระดับ เริ่มต้น" vertex="1">
          <mxGeometry height="100" width="260" x="420" y="830" as="geometry" />
