      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v6-autobenefit" name="02 การออมและสิทธิประโยชน์">
    <mxGraphModel dx="1271" dy="707" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=27;fontStyle=1;fontColor=#285F9C;align=left;" value="การออมทำงานอย่างไร — ตั้งครั้งเดียว ระบบช่วยทำตามแผน" vertex="1">
          <mxGeometry height="45" width="1900" x="50" y="25" as="geometry" />
        </mxCell>
        <mxCell id="p2-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFF;strokeColor=#B6CBE3;fontSize=14;spacing=8;align=left;" value="&lt;b&gt;หลักการต้นแบบ:&lt;/b&gt; ตั้งจำนวนคงที่และวันที่ • เปอร์เซ็นต์เป็นเพียงตัวช่วยคำนวณ • ระบบไม่ตรวจจับว่าเงินเดือนเข้า • ระดับและสิทธิประโยชน์ต้องทดสอบและผ่านการอนุมัติ" vertex="1">
          <mxGeometry height="55" width="2300" x="50" y="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-c1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;1. เลือกจำนวนที่จะออม&lt;/b&gt;&lt;br&gt;กรอกจำนวนคงที่ หรือใช้เปอร์เซ็นต์&lt;br&gt;คำนวณจากรายได้ประมาณการ" vertex="1">
          <mxGeometry height="115" width="240" x="70" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p2-c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;2. เลือกวันที่และบัญชีต้นทาง&lt;/b&gt;&lt;br&gt;เงินจะถูกจัดเข้า&lt;br&gt;กระเป๋าเงินสำรองตั้งหลัก" vertex="1">
          <mxGeometry height="115" width="240" x="370" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p2-c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;3. ตรวจทานและยินยอม&lt;/b&gt;&lt;br&gt;ดูจำนวน วันที่ บัญชี และเป้าหมาย&lt;br&gt;แก้ไข พัก หรือปิดได้" vertex="1">
          <mxGeometry height="115" width="240" x="670" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p2-c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#5B93D3;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;4. ถึงวันที่กำหนด&lt;/b&gt;&lt;br&gt;ระบบเริ่มรายการตามแผน&lt;br&gt;ด้วยกลไกตั้งโอนล่วงหน้า" vertex="1">
          <mxGeometry height="115" width="230" x="970" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p2-d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#5B93D3;strokeWidth=2;fontSize=13;fontStyle=1;" value="แผนยังเปิดอยู่&lt;br&gt;และเงินเพียงพอ?" vertex="1">
          <mxGeometry height="145" width="170" x="1270" y="215" as="geometry" />
        </mxCell>
        <mxCell id="p2-q" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2A8F6D;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;ออมเงินสำเร็จ&lt;/b&gt;&lt;br&gt;แสดงใบยืนยันแบบสั้น&lt;br&gt;ไม่แสดงคำเตือน Scam" vertex="1">
          <mxGeometry height="115" width="220" x="1530" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p2-check" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;strokeWidth=2;fontSize=13;fontStyle=1;" value="เงินที่ออมยังอยู่&lt;br&gt;ถึงวันสรุปรอบ?" vertex="1">
          <mxGeometry height="155" width="190" x="1840" y="210" as="geometry" />
