        <mxCell id="p2-count" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;นับเป็นรอบออมสำเร็จ&lt;/b&gt;&lt;br&gt;ความคืบหน้าเพิ่ม 1 รอบ" vertex="1">
