<mxfile host="app.diagrams.net" agent="Codex" compressed="false" pages="4">
  <diagram id="v6-lifecycle" name="01 ภาพรวมสำหรับผู้บริหาร">
    <mxGraphModel dx="890" dy="495" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;fontColor=#174C3C;align=left;" value="K PLUS JobShield — ออมเงินสำรองต่อเนื่อง และช่วยหยุดคิดก่อนเงินออก" vertex="1">
          <mxGeometry height="45" width="1300" x="50" y="25" as="geometry" />
        </mxCell>
        <mxCell id="p1-sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontColor=#49645C;align=left;" value="สำหรับ First Jobbers: ตั้งเป้าหมายครั้งเดียว ออมตามแผน เห็นความคืบหน้า และได้รับการปกป้องเมื่อรายการมีความเสี่ยง" vertex="1">
          <mxGeometry height="35" width="1700" x="50" y="70" as="geometry" />
        </mxCell>
        <mxCell id="p1-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8F6;strokeColor=#B7C9C2;fontSize=14;spacing=8;align=left;" value="&lt;b&gt;JobShield คืออะไร?&lt;/b&gt; K-ePocket เป็นที่เก็บเงิน ส่วน JobShield เป็นตัวช่วยตั้งเป้าหมาย ออมต่อเนื่อง แสดงสิทธิประโยชน์ และเพิ่มการตรวจสอบก่อนนำเงินสำรองออก" vertex="1">
          <mxGeometry height="55" width="2300" x="50" y="115" as="geometry" />
        </mxCell>
        <mxCell id="p1-phase1" parent="1" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#F4FBF8;swimlaneFillColor=#E7F6F0;strokeColor=#49A987;fontSize=15;fontStyle=1;fontColor=#174C3C;" value="1. เริ่มต้น — เตรียมเงินสำรองตั้งหลัก" vertex="1">
          <mxGeometry height="300" width="850" x="50" y="195" as="geometry" />
        </mxCell>
        <mxCell id="p1-s1" parent="p1-phase1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;strokeWidth=2;fontSize=13;spacing=6;" value="&lt;b&gt;มี K-ePocket อยู่แล้วหรือยัง?&lt;br&gt;&lt;/b&gt;&lt;strong&gt;มีแล้ว:&lt;/strong&gt; เลือก K-ePocket ที่ต้องการใช้&amp;nbsp;&lt;div&gt;หรือสร้างกระเป๋าใหม่&lt;b&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;strong&gt;ยังไม่มี:&lt;/strong&gt; เปิด K-ePocket ตามขั้นตอนปกติของธนาคาร&lt;/div&gt;" vertex="1">
          <mxGeometry height="208.75" width="270" x="260" y="60.620000000000005" as="geometry" />
        </mxCell>
        <mxCell id="p1-s0" parent="p1-phase1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;strong&gt;เลือกเปิดใช้งาน JobShield&lt;/strong&gt;&lt;br&gt;ผู้ใช้สามารถเปิดใช้งานได้ด้วยตนเอง และ รับทราบว่าระบบจะใช้ข้อมูลใดในการประเมินความเสี่ยง" vertex="1">
          <mxGeometry height="120" width="215" x="10" y="105" as="geometry" />
        </mxCell>
        <mxCell id="p1-e01" edge="1" parent="p1-phase1" source="p1-s0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#49A987;strokeWidth=2;" target="p1-s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-phase2" parent="1" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#F7FAFF;swimlaneFillColor=#EAF3FF;strokeColor=#5B93D3;fontSize=15;fontStyle=1;fontColor=#285F9C;" value="2. ออมต่อเนื่อง — ตั้งจำนวนเงินและวันที่" vertex="1">
          <mxGeometry height="300" width="560" x="930" y="195" as="geometry" />
        </mxCell>
        <mxCell id="p1-a1" parent="p1-phase2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;ตั้งแผนการออมรายเดือน&lt;/b&gt;&lt;br&gt;เลือกจำนวนเงิน หรือ ให้ระบบตั้งค่าเงินออมฉุกเฉินจาก&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ค่าใช้จ่าย&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ที่จำเป็นต่อเดือน&lt;/span&gt;&lt;div&gt;&lt;div&gt;และ เลือกวันที่จะออม&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ในแต่ละเดือน&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ซึ่งผู้ใช้สามารถที่จะ&lt;/span&gt;&lt;div&gt;ปรับเปลี่ยน พัก หรือยกเลิกแผนได้ทุกเมื่อ&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="159.37" width="270" x="20" y="85.31" as="geometry" />
        </mxCell>
        <mxCell id="p1-phase3" parent="1" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#FFFDF6;swimlaneFillColor=#FFF4D9;strokeColor=#D6A033;fontSize=15;fontStyle=1;fontColor=#6B5200;" value="3. เห็นความคืบหน้า — สร้างแรงจูงใจให้ออมต่อ" vertex="1">
          <mxGeometry height="300" width="830" x="1520" y="195" as="geometry" />
        </mxCell>
        <mxCell id="p1-s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A987;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;กำหนดเป้าหมายของเงินสำรอง&lt;br&gt;&lt;/b&gt;คำนวณจากค่าใช้จ่ายจำเป็นต่อเดือน แล้วเอามา × 3 หรือ 6 เดือน และเลือกใส่ยอดเริ่มต้นหรือจะเริ่มต้นที่ 0 บาทก็ได้&lt;b&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="110" width="250" x="610" y="305" as="geometry" />
        </mxCell>
        <mxCell id="p1-a2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B93D3;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;เมื่อถึงวันที่กำหนด&lt;br&gt;&lt;/b&gt;ระบบจะทำรายการตามแผนที่&lt;div&gt;ตั้งไว้ และแจ้งผลให้ผู้ใช้ทราบ&lt;b&gt;&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="200" x="1250" y="305" as="geometry" />
        </mxCell>
        <mxCell id="p1-b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6A033;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;นับรอบออมสำเร็จ&lt;/b&gt;&lt;br&gt;เมื่อออมเงินเข้าแล้ว และ&lt;div&gt;ยอดเงินยังคงอยู่จนถึงวันสรุปรอบ&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="220" x="1560" y="305" as="geometry" />
        </mxCell>
        <mxCell id="p1-b2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6A033;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;ระดับของการออม&lt;/b&gt;&lt;br&gt;1 รอบ: เริ่มต้น&lt;br&gt;3 รอบ: ต่อเนื่อง&lt;br&gt;6 รอบ: มั่นคง" vertex="1">
          <mxGeometry height="130" width="210" x="1830" y="295" as="geometry" />
        </mxCell>
        <mxCell id="p1-dash" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2A8F6D;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;หน้าสรุปเงินสำรอง&lt;/b&gt;&lt;br&gt;แสดงยอดเงินเทียบกับเป้าหมาย , จำนวนเดือนที่ครอบคลุม, แผนออม,&amp;nbsp; ระดับการออม และรอบออมถัดไป" vertex="1">
          <mxGeometry height="110" width="220" x="2090" y="305" as="geometry" />
        </mxCell>
        <mxCell id="p1-e02" edge="1" parent="1" source="p1-s1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#49A987;strokeWidth=2;" target="p1-s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e03" edge="1" parent="1" source="p1-s2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B93D3;strokeWidth=2;" target="p1-a1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e04" edge="1" parent="1" source="p1-a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B93D3;strokeWidth=2;" target="p1-a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e05" edge="1" parent="1" source="p1-a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D6A033;strokeWidth=2;" target="p1-b1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e06" edge="1" parent="1" source="p1-b1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D6A033;strokeWidth=2;" target="p1-b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e07" edge="1" parent="1" source="p1-b2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2A8F6D;strokeWidth=2;" target="p1-dash">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-out" parent="1" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#FFFDF8;swimlaneFillColor=#FFF6DF;strokeColor=#D6A033;fontSize=15;fontStyle=1;fontColor=#6B5200;" value="4. ก่อนนำเงินออก — เตือนให้ทบทวนและตรวจความเสี่ยง" vertex="1">
          <mxGeometry height="430" width="1780" x="320" y="560" as="geometry" />
        </mxCell>
        <mxCell id="p1-continue" parent="p1-out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#2A8F6D;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;ผู้ใช้ยังเป็นผู้ตัดสินใจ&lt;/b&gt;&lt;br&gt;ผู้ใช้สามารถเลือกได้ว่าจะ&amp;nbsp;&lt;div&gt;&lt;strong&gt;ใช้เงินต่อ • เก็บไว้ •&amp;nbsp;&lt;/strong&gt;&lt;/div&gt;&lt;div&gt;&lt;strong&gt;ตรวจสอบเพิ่มเติม •&amp;nbsp;&lt;/strong&gt;&lt;/div&gt;&lt;div&gt;&lt;strong&gt;หรือยกเลิกรายการ&lt;/strong&gt;&lt;br&gt;จากนั้นค่อยกลับไปยังหน้า&lt;/div&gt;&lt;div&gt;สรุปเงินสำรอง&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ฉุกเฉิน&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="260" x="1440" y="160" as="geometry" />
        </mxCell>
        <mxCell id="p1-w1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6A033;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;ผู้ใช้ต้องการนำเงินสำรองออก&lt;/b&gt;&lt;br&gt;ระบุจำนวนเงิน และ บัญชีของผู้รับ" vertex="1">
          <mxGeometry height="100" width="230" x="390" y="730" as="geometry" />
        </mxCell>
        <mxCell id="p1-w2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEFF;strokeColor=#8A63C7;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;ประเมินความเสี่ยงจากหลายปัจจัย&lt;/b&gt;&lt;br&gt;แหล่งที่มาของเงิน • บัญชีของผู้รับ &lt;br&gt;(เช็คว่าตรงกับ Blacklist ไหม) • &lt;br&gt;รูปแบบของการโอนเงิน • &lt;br&gt;วัตถุประสงค์ของการใช้จ่าย • &lt;br&gt;ความเสี่ยงของบัญชีปลายทาง" vertex="1">
          <mxGeometry height="120" width="270" x="700" y="720" as="geometry" />
        </mxCell>
        <mxCell id="p1-wd" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;strokeWidth=2;fontSize=13;fontStyle=1;" value="พบปัจจัยเสี่ยงหลายอย่างพร้อมกันหรือไม่?" vertex="1">
          <mxGeometry height="140" width="180" x="1050" y="710" as="geometry" />
        </mxCell>
        <mxCell id="p1-nudge" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D6A033;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;b&gt;ไม่พบความเสี่ยงสูง&lt;/b&gt;&lt;br&gt;มาสคอตจะแจ้งเตือนว่าเงินก้อนนี้เป็นเงินสำรองฉุกเฉิน และให้ผู้ใช้เลือกว่าจะ&amp;nbsp;&lt;div&gt;&lt;strong&gt;ใช้เงินสำรองฉุกเฉินต่อ&lt;/strong&gt; หรือ &lt;strong&gt;เก็บไว้ก่อน&lt;/strong&gt;&lt;br&gt;หากเลือกใช้ต่อ สามารถดำเนินการได้ทันที และระบบจะไม่แสดงคำเตือนซ้ำสำหรับรายการนั้น&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="300" x="1330" y="620" as="geometry" />
        </mxCell>
        <mxCell id="p1-high" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDE8;strokeColor=#E66C57;strokeWidth=2;fontSize=14;spacing=8;" value="&lt;strong&gt;พบความเสี่ยงสูง&lt;/strong&gt;&lt;br&gt;แสดงเหตุผลของความเสี่ยงอย่างชัดเจน&amp;nbsp;&lt;div&gt;โดยไม่ใช้มาสคอต&lt;br&gt;มีการพักคำสั่งโอนเงินไว้ก่อนที่&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;เงินจะออกจากบัญชี&lt;/span&gt;&lt;/div&gt;&lt;div&gt;ผู้ใช้สามารถเลือกที่จะ&amp;nbsp;&lt;strong&gt;ตรวจสอบต่อ&lt;/strong&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;หรือ &lt;strong&gt;ยกเลิกและรายงาน &lt;/strong&gt;ได้&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="300" x="1330" y="815" as="geometry" />
        </mxCell>
        <mxCell id="p1-e08" edge="1" parent="1" source="p1-dash" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;endArrow=block;endFill=1;strokeColor=#D6A033;strokeWidth=2;" target="p1-w1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2200" y="525" />
              <mxPoint x="270" y="525" />
              <mxPoint x="270" y="780" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p1-e09" edge="1" parent="1" source="p1-w1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A63C7;strokeWidth=2;" target="p1-w2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e10" edge="1" parent="1" source="p1-w2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8A63C7;strokeWidth=2;" target="p1-wd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e11" edge="1" parent="1" source="p1-wd" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;endArrow=block;endFill=1;strokeColor=#D6A033;fontSize=12;" target="p1-nudge" value="ไม่พบ">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e12" edge="1" parent="1" source="p1-wd" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;endArrow=block;endFill=1;strokeColor=#E66C57;fontSize=12;" target="p1-high" value="พบ">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-e13" edge="1" parent="1" source="p1-nudge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.3;endArrow=block;endFill=1;strokeColor=#2A8F6D;strokeWidth=2;" target="p1-continue">
